# Global git excludes (core.excludesfile → ~/.gitignore).
#
# Only things that are noise in EVERY repo. Anything specific to one repo,
# including this one, belongs in that repo's own .gitignore — an entry here
# silently applies everywhere.

# macOS and Windows folder cruft
.DS_Store
Desktop.ini
._*
Thumbs.db
.Spotlight-V100
.Trashes

# Logs and local environment
log/
*.log
.env

# Agent workspaces (jj) and per-repo agent settings, which can appear anywhere
.jj-workspaces/
**/.claude/settings.local.json
