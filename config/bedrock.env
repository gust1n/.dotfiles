# Anthropic Claude model IDs on Amazon Bedrock — single source of truth.
#
# Sourced by:
#   bin/pi-settings-sync      → ~/.pi/agent/settings.json
#   bin/claude-settings-sync  → ~/.claude/settings.json
#   bin/herdr-jj              → loop layout + tier-select fallbacks
#   bash_profile              → shell env (so `claude` inherits them directly)
#
# To switch model generations, change the two lines below and run:
#   bin/pi-settings-sync
#   bin/claude-settings-sync
BEDROCK_OPUS_MODEL=eu.anthropic.claude-opus-5
BEDROCK_SONNET_MODEL=eu.anthropic.claude-sonnet-5
