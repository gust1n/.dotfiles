#!/usr/bin/env bash
# herdr-jj — jj-workspace-backed agent sessions for herdr.
#
# Each agent gets its own jj workspace (a second working copy of the same repo)
# so parallel agents never touch each other's files, and the MAIN checkout stays
# yours for reading and hand-editing.
#
# herdr owns all the UI: workspaces, the sidebar, agent state icons, the
# attention queue. This script only does the parts herdr has no opinion about —
# creating/forgetting jj workspaces and launching the agent in them.
#
#   new      pick a repo, then one ranked list: attach to an existing workspace,
#            branch off one of your bookmarks, or type a name for fresh work.
#            Idempotent — a name that already has a workspace attaches to it,
#            which is why there is no separate resume/ls command.
#   rm       forget a jj workspace, delete it, close its herdr workspace
#   tidy     sweep dead workspaces, divergent commits, conflicted bookmarks

set -uo pipefail

CODE_DIR="${CODE_DIR:-$HOME/Code}"
# Keep agent checkouts out of the repos themselves: no .gitignore entries, and
# an agent's tooling can't wander into a sibling workspace. Mirrors herdr's own
# ~/.herdr/worktrees convention (which is git-only, hence the separate dir).
WS_ROOT="${HERDR_JJ_ROOT:-$HOME/.herdr/workspaces}"
AGENT_CMD="${HERDR_JJ_AGENT:-claude --dangerously-skip-permissions}"
# Which CLI a bare --model/tier choice launches: claude (Claude Code) or pi.
# --agent (an explicit full command) always overrides this.
HARNESS="${HERDR_JJ_HARNESS:-claude}"

# Load canonical model IDs from dotfiles if available.
_DOTFILES="${DOTFILES_DIR:-$HOME/Code/dotfiles}"
if [ -f "$_DOTFILES/config/bedrock.env" ]; then
  # shellcheck source=/dev/null
  source "$_DOTFILES/config/bedrock.env"
fi

# Canonical model IDs, resolved once. Both env-var families are ultimately set
# from config/bedrock.env (see bashrc.d/100.bedrock-models.sh), so claude and
# pi land on the same underlying model regardless of which harness is chosen.
OPUS_MODEL="${ANTHROPIC_DEFAULT_OPUS_MODEL:-${BEDROCK_OPUS_MODEL:-eu.anthropic.claude-opus-5}}"
SONNET_MODEL="${ANTHROPIC_DEFAULT_SONNET_MODEL:-${BEDROCK_SONNET_MODEL:-eu.anthropic.claude-sonnet-5}}"

# Models for the 3-agent loop layout. Env override still works.
LOOP_PLANNER_MODEL="${LOOP_PLANNER_MODEL:-$OPUS_MODEL}"
LOOP_WORKER_MODEL="${LOOP_WORKER_MODEL:-$SONNET_MODEL}"
LOOP_JUDGE_MODEL="${LOOP_JUDGE_MODEL:-$SONNET_MODEL}"

# --- plumbing ---------------------------------------------------------------

die() { echo "error: $*" >&2; exit 1; }

# Popups close the instant the script exits, taking the error message with it.
die_pause() {
  echo "error: $*" >&2
  [[ -t 0 ]] && { printf '\npress enter to close...'; read -r _; }
  exit 1
}

need() {
  for c in "$@"; do
    command -v "$c" >/dev/null || die_pause "$c not found on PATH"
  done
}

_fzf() { fzf --prompt="$1> " --height=100% --reverse --bind='ctrl-j:down,ctrl-k:up'; }

# fzf over "<value>TAB<display>" lines: only the display half is shown and
# searched, but the full line comes back so the caller can recover the value.
# An unmatched query is itself a valid answer (a name for new work), and
# --no-sort preserves the ranking we fed in.
_fzf_or_new() {
  local out query match
  out=$(fzf --prompt="$1> " --height=100% --reverse --no-sort \
            --delimiter='\t' --with-nth=2.. --nth=2.. \
            --bind='ctrl-j:down,ctrl-k:up' --print-query 2>/dev/null) || true
  query=$(sed -n '1p' <<<"$out")
  match=$(sed -n '2p' <<<"$out")
  if [[ -n "$match" ]]; then printf '%s\n' "$match"
  elif [[ -n "$query" ]]; then printf '%s\n' "$query"
  else return 1; fi
}

# "3d" / "2w" / "5mo" — how long ago, from a unix timestamp. Empty if unknown.
ago() {
  local ts="$1" now d
  [[ -z "$ts" || "$ts" == "0" ]] && return
  now=$(date +%s)
  d=$(( (now - ts) / 86400 ))
  (( d < 0 )) && d=0
  if   (( d == 0 ));  then printf 'today'
  elif (( d < 7 ));   then printf '%dd' "$d"
  elif (( d < 60 ));  then printf '%dw' "$(( d / 7 ))"
  else                     printf '%dmo' "$(( d / 30 ))"
  fi
}

# Path-safe slug. Bookmarks may contain '/' ("gustin/fix-auth"); paths shouldn't.
slug() {
  local s
  s=$(printf '%s' "$1" | tr -c 'A-Za-z0-9' '-' | tr 'A-Z' 'a-z' | tr -s '-')
  s="${s#-}"; s="${s%-}"
  printf '%s\n' "${s:-workspace}"
}

# Repo roots under $CODE_DIR, as paths relative to it. Anything containing a
# .git or .jj counts, so plain-git repos are offered too (ensure_jj colocates
# jj into them on first use).
_discover_repos() {
  local d
  { if command -v fd >/dev/null; then
      fd --no-ignore --hidden --follow --type d --max-depth 6 \
         '^\.git$|^\.jj$' "$CODE_DIR" 2>/dev/null
    else
      find "$CODE_DIR" -maxdepth 6 \( -name .git -o -name .jj \) 2>/dev/null
    fi
  } | while IFS= read -r d; do
        d="${d%/}"                    # fd emits a trailing slash on dirs
        d="${d%/.git}"; d="${d%/.jj}" # strip the marker, leaving the repo root
        # Skip vendored/nested checkouts: tmux plugins, node_modules, backups,
        # agent workspaces. Without this, one repo's submodules bury the list.
        case "$d" in
          *"/.jj-workspaces/"*|*"/.herdr/"*|*"/node_modules/"*|\
          *"/plugins/"*|*"/vendor/"*|*"/bak/"*|*"/.git/"*|*"/.terraform/"*) continue ;;
        esac
        printf '%s\n' "${d#"$CODE_DIR"/}"
      done | sort -u
}

# A jj repo has exactly one MAIN workspace, which stores .jj/repo as the store
# DIRECTORY. Every secondary (agent) workspace stores .jj/repo as a FILE holding
# a relative path to that store. This is how we tell the two apart anywhere,
# without caring where on disk the checkout lives — the same test agent-guard
# uses to decide whether to sandbox a session.
is_main_ws() { [[ -d "$1/.jj/repo" ]]; }
is_agent_ws() { [[ -f "$1/.jj/repo" ]]; }

# Resolve any workspace path to its repo's MAIN root by following .jj/repo.
main_root() {
  local ws="$1" ptr
  is_main_ws "$ws" && { printf '%s\n' "$ws"; return; }
  ptr=$(cat "$ws/.jj/repo" 2>/dev/null) || { printf '%s\n' "$ws"; return; }
  # Pointer is relative to .jj/ and ends in /repo: strip 'repo' then '.jj'.
  ( cd "$ws/.jj/$ptr/../.." 2>/dev/null && pwd -P ) || printf '%s\n' "$ws"
}

# Read-only queries against a repo we're not standing in. --ignore-working-copy
# keeps us from snapshotting someone else's working copy as a side effect.
jjq() { jj --ignore-working-copy -R "$1" "${@:2}"; }
rev_exists() { jjq "$1" log -r "$2" --no-graph --limit 1 >/dev/null 2>&1; }

ensure_jj() {
  local repo="$1"
  [[ -d "$repo/.jj" ]] || jj git init --colocate "$repo" >/dev/null 2>&1 \
    || die_pause "could not initialise jj in $repo"
  jjq "$repo" git import >/dev/null 2>&1 || true
}

# Prefer resuming published work over starting fresh: an existing bookmark of
# this name (remote first) means "continue that", not "branch off trunk".
base_rev() {
  local repo="$1" name="$2"
  for r in "${name}@origin" "$name" 'main@origin' 'master@origin' 'trunk()'; do
    rev_exists "$repo" "$r" && { printf '%s\n' "$r"; return; }
  done
  printf '@\n'
}

# --- herdr side -------------------------------------------------------------

# The workspace whose root pane sits at this path, if herdr still has one open.
# herdr reports fully-resolved cwds (/private/tmp/… on macOS), so resolve ours
# before comparing or every lookup misses.
ws_ids_for_cwd() {
  local path="$1" real
  real=$(cd "$path" 2>/dev/null && pwd -P) || real="$path"
  herdr api snapshot 2>/dev/null | jq -r --arg p "$real" --arg q "$path" '
    .result.snapshot as $s
    | ($s.panes // [])[] | select(.cwd == $p or .cwd == $q)
    | .workspace_id' 2>/dev/null | sort -u
}

ws_id_for_cwd() { ws_ids_for_cwd "$1" | head -1; }

open_ws() {
  local path="$1" label="$2" out id
  id=$(ws_id_for_cwd "$path")
  if [[ -n "$id" ]]; then
    herdr workspace focus "$id" >/dev/null 2>&1
    printf '%s\n' "FOCUSED"
    return
  fi
  out=$(herdr workspace create --cwd "$path" --label "$label" --focus 2>&1) \
    || die_pause "herdr workspace create failed: $out"
  jq -r '.result.root_pane.pane_id // empty' <<<"$out" 2>/dev/null
}

# Launch the agent in a pane. With a prompt, use `agent start` (blocks until the
# agent is genuinely ready) then `agent prompt` — no sleep-and-hope. Without one,
# just type the command and hand the user a live terminal.
launch() {
  local pane="$1" prompt="${2:-}"
  if [[ -z "$prompt" ]]; then
    herdr pane run "$pane" $AGENT_CMD >/dev/null 2>&1
    return
  fi
  # Split "claude --flag" into kind + flags. A bare command has no flags.
  local kind="${AGENT_CMD%% *}" args=""
  [[ "$AGENT_CMD" == *" "* ]] && args="${AGENT_CMD#* }"
  if ! herdr agent start "$kind" --kind "$kind" --pane "$pane" --timeout 60000 \
       -- $args >/dev/null 2>&1; then
    echo "warning: agent did not report ready; typing the prompt anyway" >&2
    herdr pane run "$pane" $AGENT_CMD >/dev/null 2>&1
    sleep 5
  fi
  herdr agent prompt "$pane" "$prompt" >/dev/null 2>&1 \
    || echo "warning: could not submit the prompt; the agent is waiting for input" >&2
}

# --- the picker -------------------------------------------------------------

# One ranked list of everything you might want to work on in this repo, most
# likely first. Selecting an existing workspace attaches to it; selecting a
# bookmark branches a new workspace off it; typing a new name starts fresh.
#
# Ranking matters more than filtering here: a repo can have 150+ remote
# bookmarks (dependabot, every colleague's branch), but a LOCAL bookmark means
# you have touched it, which is the signal that separates your work from theirs.
# Nothing is hidden — fzf substring matching keeps a colleague's branch one
# keystroke away — it just sorts last.
#
#   1. live workspaces   (an agent is running there)
#   2. idle workspaces   (checkout on disk, no agent)
#   3. your bookmarks    (local == you've touched it), newest first
#   4. remote bookmarks  (colleagues, bots), newest first
#
# Prints the chosen name on stdout. Column 1 is the value; the rest is display.
pick_target() {
  local repo="$1" repo_name
  repo_name=$(basename "$repo")

  # Which workspace dirs exist, and which have a live agent (one snapshot).
  local live_cwds
  live_cwds=$(herdr api snapshot 2>/dev/null | jq -r '
    (.result.snapshot.panes // [])[]
    | select(.agent != null)
    | .cwd' 2>/dev/null)

  # "<name>\t<unix-ts>" for one set of bookmarks, newest first, deduped.
  # jj emits a row per local + per remote, so several rows can share a name;
  # sort -u then a numeric sort by age handles that without cross-referencing.
  # $1 = a jj condition selecting which bookmarks to include. The whole line is
  # suppressed when it doesn't match, otherwise a filtered-out bookmark would
  # still emit a bare "\t<timestamp>" row.
  marks() {
    jjq "$repo" bookmark list ${2:+--all-remotes} -T '
        if('"$1"',
           self.name() ++ "\t"
           ++ if(self.normal_target(),
                 self.normal_target().committer().timestamp().format("%s"), "0")
           ++ "\n",
           "")' 2>/dev/null \
      | sed '/^$/d' | sort -u \
      | sort -t"$(printf '\t')" -k1,1 -k2,2nr | awk -F'\t' '!seen[$1]++' \
      | sort -t"$(printf '\t')" -k2,2nr
  }

  local seen_names="" d name real
  local picked
  picked=$( {
      # Value "+" is a sentinel: chosen from the list rather than typed, so ask
      # for the name instead of silently doing nothing.
      printf '+\t+ new agent  (or type a name here)\n'

      # 1/2. Workspaces on disk — live ones first. Selecting one attaches.
      for d in "$WS_ROOT/$repo_name"/*; do
        [[ -d "$d" ]] || continue
        is_agent_ws "$d" || continue
        name=$(basename "$d")
        real=$(cd "$d" 2>/dev/null && pwd -P) || real="$d"
        if grep -qxF -e "$real" -e "$d" <<<"$live_cwds"; then
          printf '0\t%s\t%-32s %s\n' "$name" "● $name" "agent"
        else
          printf '1\t%s\t%-32s %s\n' "$name" "○ $name" "workspace"
        fi
      done | sort -t"$(printf '\t')" -k1,1n | cut -f2-

      # 3. Your bookmarks (a local bookmark == you've touched it), newest first.
      # 4. Everyone else's (remote and untracked): colleagues, dependabot.
      # A workspace listed above already covers its bookmark, so skip those.
      # Names already shown (as a workspace, or in an earlier group) are skipped,
      # so nothing appears twice.
      seen_names=$(printf '%s\n' "$WS_ROOT/$repo_name"/* | xargs -n1 basename 2>/dev/null)
      emit_marks() {   # $1 = jj condition, $2 = label, $3 = --all-remotes?
        local nm ts
        while IFS=$'\t' read -r nm ts; do
          [[ -z "$nm" ]] && continue
          grep -qxF "$nm" <<<"$seen_names" && continue
          seen_names+=$'\n'"$nm"
          printf '%s\t%-32s %s\n' "$nm" "  $nm" "$2${ts:+ · $(ago "$ts")}"
        done < <(marks "$1" "${3:-}")
      }
      emit_marks 'true' local
      emit_marks 'self.remote() && !self.tracked()' origin remotes
    } | _fzf_or_new "work on" ) || return 1

  # Selected a row -> take the hidden value field; typed a name -> it has no tab.
  picked="${picked%%$'\t'*}"

  if [[ "$picked" == "+" ]]; then
    printf 'name for the new work: ' >&2
    read -r picked || return 1
    picked="${picked#"${picked%%[![:space:]]*}"}"   # trim leading space
    picked="${picked%"${picked##*[![:space:]]}"}"   # trim trailing space
    [[ -z "$picked" ]] && return 1
  fi

  printf '%s\n' "$picked"
}

# --- model + harness pickers ------------------------------------------------

# Interactive model-tier prompt. Esc or empty input → opus (default).
# Returns a bare tier keyword: opus, sonnet, haiku, or loop.
pick_model() {
  local choice
  choice=$(printf '%s\n' \
      'opus    planner / orchestrator' \
      'sonnet  worker / balanced' \
      'haiku   simple tasks / cheapest' \
      'loop    3-agent loop: planner + worker + judge' \
    | fzf --prompt='model> ' --height=30% --reverse --no-sort --no-multi \
          --bind='ctrl-j:down,ctrl-k:up' \
          --header='↵ accept · esc = opus (default)' 2>/dev/null) || true
  local tier="${choice%% *}"  # first word; empty if Esc
  printf '%s\n' "${tier:-opus}"
}

# Interactive harness prompt. Esc or empty input → claude (default).
# Returns a bare harness keyword: claude or pi.
pick_harness() {
  local choice
  choice=$(printf '%s\n' \
      'claude  Claude Code' \
      'pi      pi' \
    | fzf --prompt='harness> ' --height=20% --reverse --no-sort --no-multi \
          --bind='ctrl-j:down,ctrl-k:up' \
          --header='↵ accept · esc = claude (default)' 2>/dev/null) || true
  local h="${choice%% *}"
  printf '%s\n' "${h:-claude}"
}

# tier + harness -> a launch command. "loop" is not a real tier here; callers
# check for it before calling this.
build_agent_cmd() {
  local harness="$1" tier="$2" model
  case "$tier" in
    sonnet|haiku) model="$SONNET_MODEL" ;;
    *)            model="$OPUS_MODEL" ;;
  esac
  case "$harness" in
    pi)      printf 'pi --model %s\n' "$model" ;;
    claude|*) printf 'claude --dangerously-skip-permissions --model %s\n' "$model" ;;
  esac
}

# --- loop layout ------------------------------------------------------------

# Start a role agent in a pane with its role baked into the system prompt.
# Blocks until the agent is ready (up to 60 s). Falls back to pane run if
# agent start times out (e.g. root pane still settling after workspace create).
#
# $agent_name (the herdr identity used for --name / agent start / prompt /
# focus) is namespaced per session (see launch_loop) — herdr resolves
# `agent prompt <name>` globally, not scoped to a workspace, so two loop
# sessions both registering a bare "worker" would make prompts cross-talk
# between them (confirmed by hand: session B's message landed in session A's
# worker pane). $role only picks the system prompt and the cosmetic sidebar
# label; it is not used for addressing.
_loop_start_agent() {
  local pane="$1" role="$2" agent_name="$3" model="$4" harness="$5"

  # Role-specific system prompt appended to the agent's default so it knows
  # its job without the user having to explain it on every session start.
  local role_prompt
  case "$role" in
    planner)
      role_prompt='You are the planner in a 3-agent development loop (planner / worker / judge) running inside herdr. The other agents in this workspace are: worker (top-right) and judge (bottom-left).

Your own herdr agent identity, and theirs, are namespaced per session (not the bare words "worker"/"judge") to avoid cross-talk with other loop sessions running elsewhere. Compute them yourself before signalling anyone: NS=$(basename "$PWD"); WORKER_AGENT="${NS}-worker"; JUDGE_AGENT="${NS}-judge". Use $WORKER_AGENT / $JUDGE_AGENT in every `herdr agent` command instead of the bare role name.

When the user gives you a task, immediately load /planner-role — do not wait to be asked. Bootstrap the session: resolve the main repo path, create the plan file under .plans/, signal the worker and judge with the plan path and their role skill, then begin grilling requirements from the user.' ;;
    worker)
      role_prompt='You are the worker in a 3-agent development loop. Your herdr agent identity is namespaced per session — before signalling the planner, compute it: NS=$(basename "$PWD"); PLANNER_AGENT="${NS}-planner". Use $PLANNER_AGENT (not the bare word "planner") in every `herdr agent` command. You will receive phase signals from the planner via herdr. When signalled, load /worker-role and implement the work as directed. Until then, wait quietly.' ;;
    judge)
      role_prompt='You are the judge in a 3-agent development loop. Your herdr agent identity is namespaced per session — before signalling the planner, compute it: NS=$(basename "$PWD"); PLANNER_AGENT="${NS}-planner". Use $PLANNER_AGENT (not the bare word "planner") in every `herdr agent` command. You will receive review signals from the planner via herdr. When signalled, load /judge-role and perform an adversarial cold review. Until then, wait quietly.' ;;
    terminal)
      role_prompt='' ;;  # plain shell, no agent
    *)
      role_prompt='' ;;
  esac

  # `agent start`'s argv encoding rejects a multi-line, em-dash-bearing
  # role_prompt outright (invalid_agent_argument, in well under a second —
  # not an actual timeout). Both pi's --append-system-prompt and claude's
  # --append-system-prompt-file accept a file path, so write the prompt to a
  # temp file and pass the (short, single-line) path instead. This is what
  # makes `agent start` succeed directly, register the live name, and skip
  # the fallback below in the common case.
  local role_prompt_file=""
  if [[ -n "$role_prompt" ]]; then
    role_prompt_file=$(mktemp "${TMPDIR:-/tmp}/herdr-jj-role-prompt.XXXXXX")
    printf '%s\n' "$role_prompt" > "$role_prompt_file"
  fi

  # Build harness-specific args. Both take --model, a role-prompt file, and a
  # display name; the flag spellings differ.
  local kind cmd_name args=()
  case "$harness" in
    pi)
      kind=pi; cmd_name=pi
      args=(--model "$model" --no-session --name "$agent_name")
      [[ -n "$role_prompt_file" ]] && args+=(--append-system-prompt "$role_prompt_file")
      ;;
    claude|*)
      kind=claude; cmd_name=claude
      args=(--model "$model" --dangerously-skip-permissions -n "$agent_name")
      [[ -n "$role_prompt_file" ]] && args+=(--append-system-prompt-file "$role_prompt_file")
      ;;
  esac

  if ! herdr agent start "$agent_name" --kind "$kind" --pane "$pane" --timeout 60000 \
       -- "${args[@]}" >/dev/null 2>&1; then
    # `agent start` failing does not mean the agent failed to launch — it may
    # have started fine and herdr's readiness detection just lagged past the
    # timeout. `agent get` returns agent_not_found only when nothing is
    # running in the pane at all. Trust that distinction: if it is already
    # there, re-running `pane run` below would type the launch command as a
    # chat message into the live agent instead of starting a new process
    # (confirmed by hand: the agent picks it up and starts "working" on it).
    local detected=0 waited=0
    while (( waited < 30 )); do
      herdr agent get "$pane" >/dev/null 2>&1 && { detected=1; break; }
      sleep 1
      ((waited++))
    done

    if (( detected == 1 )); then
      echo "warning: $agent_name agent start reported an error, but $cmd_name is already running in $pane; skipping re-launch" >&2
    else
      echo "warning: $agent_name $cmd_name never started in $pane; falling back to pane run" >&2
      # Keep the role prompt (now a file path) in the fallback too. Without
      # it the planner never learns it must load /planner-role and
      # delegate, and worker/judge never learn to wait quietly for a
      # signal — each just behaves like a bare solo agent handed the raw
      # task.
      local fallback_cmd
      printf -v fallback_cmd '%q ' "$cmd_name" "${args[@]}"
      herdr pane run "$pane" "$fallback_cmd" >/dev/null 2>&1
      sleep 4  # give the agent time to draw its UI before reporting metadata
    fi

    # Neither path above is a *successful* `agent start`, so herdr's live
    # agent name was never registered (only a successful `agent start`
    # does that). Without a live name, `herdr agent prompt "$agent_name"`
    # fails with agent_not_found later, even though herdr auto-classifies
    # the pane (display_agent) correctly. Register it now, retrying briefly
    # since detection can still lag by a beat.
    local rename_tries=0
    until herdr agent rename "$pane" "$agent_name" >/dev/null 2>&1; do
      ((rename_tries++))
      if (( rename_tries >= 10 )); then
        echo "warning: could not register live name '$agent_name' for $pane;" \
          "target it by pane ID ($pane) instead of by name" >&2
        break
      fi
      sleep 1
    done
  fi

  # Both harnesses read their role-prompt file at startup, well before this
  # point in either the `agent start` success path or the fallback above, so
  # it is safe to remove the temp file now.
  [[ -n "$role_prompt_file" ]] && rm -f "$role_prompt_file"

  # Override the sidebar 'agent' token so the role name shows instead of the
  # raw harness. No --applies-to-source filter: the root pane starts as a
  # shell before the agent runs in it, so herdr may not have re-detected the
  # source yet.
  herdr pane report-metadata "$pane" \
    --source "herdr-jj:loop" --agent "$kind" \
    --display-agent "$role" 2>/dev/null || true
}

# Build a 3-agent + 1 terminal layout.
#
#   root_pane (planner) | worker_pane
#   judge_pane           | term_pane (shell — run builds, tail logs)
#
# $session_name namespaces each agent's herdr identity (see
# _loop_start_agent's header comment for why). All four panes share $path as
# their cwd, so any agent can independently recompute the same namespace via
# `basename "$PWD"` — no need to pass identities around out of band.
launch_loop() {
  local root_pane="$1" prompt="${2:-}" path="${3:-$PWD}" session_name="${4:-loop}" harness="${5:-claude}"

  local ns; ns=$(slug "$session_name")
  local planner_agent="${ns}-planner" worker_agent="${ns}-worker" \
        judge_agent="${ns}-judge"

  echo "creating loop layout (planner | worker / judge | terminal) [$harness]..." >&2

  local worker_pane judge_pane term_pane
  worker_pane=$(herdr pane split --pane "$root_pane" --direction right \
    --cwd "$path" --no-focus 2>/dev/null | jq -r '.result.pane.pane_id // empty')
  [[ -n "$worker_pane" ]] || { echo "error: could not create worker pane" >&2; return 1; }

  judge_pane=$(herdr pane split --pane "$root_pane" --direction down \
    --cwd "$path" --no-focus 2>/dev/null | jq -r '.result.pane.pane_id // empty')
  [[ -n "$judge_pane" ]] || { echo "error: could not create judge pane" >&2; return 1; }

  term_pane=$(herdr pane split --pane "$worker_pane" --direction down \
    --cwd "$path" --no-focus 2>/dev/null | jq -r '.result.pane.pane_id // empty')
  [[ -n "$term_pane" ]] || { echo "error: could not create terminal pane" >&2; return 1; }

  echo "starting agents: planner → worker → judge (~30s each)..." >&2
  sleep 2  # let the root pane shell fully settle before agent start
  _loop_start_agent "$root_pane"   planner "$planner_agent" "$LOOP_PLANNER_MODEL" "$harness"
  _loop_start_agent "$worker_pane" worker  "$worker_agent"  "$LOOP_WORKER_MODEL"  "$harness"
  _loop_start_agent "$judge_pane"  judge   "$judge_agent"   "$LOOP_JUDGE_MODEL"   "$harness"
  # term_pane stays as a plain shell
  herdr pane report-metadata "$term_pane" \
    --source "herdr-jj:loop" --agent "$harness" \
    --display-agent "terminal" 2>/dev/null || true

  herdr agent focus "$planner_agent" 2>/dev/null || true

  # Always send the planner a kick-off. If the user passed --prompt use it as
  # the task directly; otherwise prompt them to describe what to build.
  local init_msg="${prompt:-Worker and judge are ready. Describe your task and I will start the loop.}"
  herdr agent prompt "$planner_agent" "$init_msg" 2>/dev/null \
    || echo "warning: could not deliver initial prompt to planner" >&2

  printf 'loop ready [%s]\n  planner (opus)     %s  %s\n  worker (sonnet)    %s  %s\n  judge (sonnet-5)   %s  %s\n  terminal           %s\n' \
    "$harness" "$root_pane" "$planner_agent" "$worker_pane" "$worker_agent" "$judge_pane" "$judge_agent" "$term_pane" >&2
}

# --- commands ---------------------------------------------------------------

cmd_new() {
  local repo="" name="" prompt="" agent="" model_tier="" model_specified=0 \
        harness_specified=0 layout=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)    repo="${2:-}"; shift 2 ;;
      --name)    name="${2:-}"; shift 2 ;;
      --prompt)  prompt="${2:-}"; shift 2 ;;
      --layout)  layout="${2:-}"; model_specified=1; shift 2 ;;
      --harness) HARNESS="${2:-}"; harness_specified=1; shift 2 ;;
      --agent)   agent="${2:-}"; model_specified=1; shift 2 ;;
      --model)
        case "${2:-}" in
          opus|sonnet|haiku) model_tier="$2" ;;
          loop)              layout="loop" ;;
          *)                 agent="claude --dangerously-skip-permissions --model ${2:-}" ;;
        esac
        model_specified=1; shift 2 ;;
      *) shift ;;
    esac
  done
  # Precedence: an explicit --agent command wins outright; otherwise a tier
  # (from --model) is resolved against --harness (default claude).
  if [[ -n "$agent" ]]; then
    AGENT_CMD="$agent"
  elif [[ -n "$model_tier" ]]; then
    AGENT_CMD=$(build_agent_cmd "$HARNESS" "$model_tier")
  fi

  local interactive=0
  [[ -z "$repo" || -z "$name" ]] && interactive=1

  if (( interactive )); then
    need herdr jj jq fzf
    local rel
    rel=$(_discover_repos | _fzf "repo") || return 0
    [[ -z "$rel" ]] && return 0
    repo="$CODE_DIR/$rel"
  else
    need herdr jj jq
  fi

  [[ -d "$repo" ]] || die_pause "no such repo: $repo"
  # Launching from inside an agent workspace should still base the new one off
  # the real repo, not nest workspaces inside a workspace.
  repo=$(main_root "$repo")
  ensure_jj "$repo"

  if (( interactive )); then
    name=$(pick_target "$repo") || return 0
    [[ -z "$name" ]] && return 0
    if (( ! model_specified )); then
      model_tier=$(pick_model)
      (( harness_specified )) || HARNESS=$(pick_harness)
      if [[ "$model_tier" == "loop" ]]; then
        layout="loop"
      else
        AGENT_CMD=$(build_agent_cmd "$HARNESS" "$model_tier")
      fi
    elif [[ -z "$agent" ]] && (( ! harness_specified )); then
      # A tier or --layout loop came from a flag but no --harness and no full
      # --agent override: still worth asking which CLI runs it.
      HARNESS=$(pick_harness)
      [[ -n "$model_tier" ]] && AGENT_CMD=$(build_agent_cmd "$HARNESS" "$model_tier")
    fi
  fi

  name="${name%@origin}"
  local repo_name path
  repo_name=$(basename "$repo")
  path="$WS_ROOT/$repo_name/$(slug "$name")"

  # Attach: the checkout already exists. If herdr still has it open we just focus
  # it (open_ws returns FOCUSED); otherwise reopen and continue the previous
  # conversation rather than starting a blank one.
  if [[ -d "$path" ]]; then
    jj -R "$path" workspace update-stale >/dev/null 2>&1 || true
    local pane
    pane=$(open_ws "$path" "$name")
    if [[ "$pane" == "FOCUSED" ]]; then
      echo "attached to running agent: ${path/#$HOME/~}" >&2
      return 0
    fi
    [[ -z "$pane" ]] && die_pause "herdr did not return a pane for $path"
    echo "reopened ${path/#$HOME/~}" >&2
    # Re-trust in case the workspace was cleaned or mise's cache expired.
    command -v mise >/dev/null 2>&1 && mise trust "$path" >/dev/null 2>&1 || true
    if [[ -n "$prompt" ]]; then
      launch "$pane" "$prompt"
    else
      # --continue resumes the prior session in this directory.
      herdr pane run "$pane" $AGENT_CMD --continue >/dev/null 2>&1
    fi
    return 0
  fi

  # Start from what origin has now, not what we last fetched. Non-fatal: offline
  # just means basing on the local trunk.
  jjq "$repo" git fetch >/dev/null 2>&1 \
    || echo "warning: jj git fetch failed; basing on the local trunk" >&2

  local base
  base=$(base_rev "$repo" "$name")

  mkdir -p "$(dirname "$path")" || die_pause "could not create $(dirname "$path")"
  # A stale entry under this name blocks `workspace add`; drop it first.
  jjq "$repo" workspace forget "$name" >/dev/null 2>&1 || true
  # `workspace add` writes a working copy, so it cannot run under
  # --ignore-working-copy. Run it inside the repo instead.
  local add_err
  add_err=$( cd "$repo" && jj workspace add --name "$name" -r "$base" "$path" 2>&1 ) \
    || die_pause "jj workspace add failed (name=$name base=$base): $add_err"

  # Give the agent a bookmark to land work on, matching the workspace name.
  jj -R "$path" bookmark create "$name" -r '@' >/dev/null 2>&1 \
    || jj -R "$path" bookmark set "$name" -r '@' >/dev/null 2>&1 \
    || echo "warning: could not create bookmark $name" >&2

  # Trust mise config files in the workspace so the agent shell can find tools
  # immediately — without this, mise shows a trust prompt before claude starts.
  command -v mise >/dev/null 2>&1 && mise trust "$path" >/dev/null 2>&1 || true

  echo "created $path (base: $base)" >&2
  local pane
  pane=$(open_ws "$path" "$name")
  [[ -n "$pane" && "$pane" != "FOCUSED" ]] || die_pause "herdr did not return a pane"
  if [[ "$layout" == "loop" ]]; then
    launch_loop "$pane" "$prompt" "$path" "$name" "$HARNESS"
  else
    launch "$pane" "$prompt"
  fi
}

# Not an agent workspace: behave like herdr's native close_workspace. Prefer the
# id herdr injected into this process; a popup inherits the calling pane's
# context, so that is the workspace the user is looking at. Fall back to whatever
# herdr currently reports as focused.
close_this_workspace() {
  local id="${HERDR_WORKSPACE_ID:-}"
  [[ -z "$id" ]] && id=$(herdr api snapshot 2>/dev/null \
    | jq -r '.result.snapshot.focused_workspace_id // empty' 2>/dev/null)
  [[ -z "$id" ]] && die_pause "no herdr workspace to close"

  local label
  label=$(herdr api snapshot 2>/dev/null | jq -r --arg i "$id" \
    '(.result.snapshot.workspaces // [])[] | select(.workspace_id==$i) | .label' 2>/dev/null)

  # Closing kills the pane processes, so confirm when there is a terminal to ask.
  if [[ -t 0 ]]; then
    printf 'close workspace %s? [y/N] ' "${label:-$id}"
    read -r ans
    [[ "$ans" == [yY] ]] || { echo "aborted."; return 0; }
  fi
  herdr workspace close "$id" >/dev/null 2>&1 \
    || die_pause "herdr workspace close $id failed"
  echo "closed workspace ${label:-$id}"
}

cmd_rm() {
  need herdr jj jq
  local path="${1:-}"

  if [[ -z "$path" ]]; then
    # Bound to prefix+shift+d, which is herdr's own close_workspace. Keep that
    # meaning: in an agent workspace, remove the checkout too; anywhere else fall
    # back to plain "close this herdr workspace", so the key behaves natively
    # while you're just coding.
    if is_agent_ws "$(jj workspace root 2>/dev/null || echo /nonexistent)"; then
      path=$(jj workspace root)
    else
      close_this_workspace
      return $?
    fi
  fi

  path=$(cd "$path" 2>/dev/null && pwd -P) || die_pause "no such path: $path"
  is_main_ws "$path" && die_pause "refusing to remove the MAIN workspace ($path)"
  is_agent_ws "$path" || die_pause "not a jj workspace: $path"
  [[ "$path" == "$HOME" || "$path" == "/" ]] && die_pause "refusing to remove $path"

  # Warn about work that would vanish with the checkout.
  local unpushed
  unpushed=$(jj --ignore-working-copy -R "$path" log \
    -r 'mutable() & ~empty() & ::@ & ~(::remote_bookmarks())' --no-graph \
    -T 'description.first_line() ++ "\n"' 2>/dev/null | sed '/^$/d')
  if [[ -n "$unpushed" && -t 0 ]]; then
    echo "unpushed commits in this workspace:" >&2
    sed 's/^/  /' <<<"$unpushed" >&2
    printf 'remove anyway? [y/N] '
    read -r ans
    [[ "$ans" == [yY] ]] || { echo "aborted."; return 0; }
  fi

  # Close every herdr workspace pointing here, not just the first — reopening a
  # checkout can leave more than one behind.
  local ids
  ids=$(ws_ids_for_cwd "$path")

  jj --ignore-working-copy -R "$path" workspace forget >/dev/null 2>&1 \
    || echo "warning: jj workspace forget failed; removing the checkout anyway" >&2
  rm -rf "$path" || die_pause "could not delete $path"
  while IFS= read -r id; do
    [[ -n "$id" ]] && herdr workspace close "$id" >/dev/null 2>&1
  done <<<"$ids"

  echo "removed ${path/#$HOME/~}"
}

# Sweep the debris parallel agents leave behind. No herdr equivalent — this is
# pure jj bookkeeping.
cmd_tidy() {
  need jj jq
  local repo="${1:-$(pwd)}"
  jj -R "$repo" root >/dev/null 2>&1 || die "not a jj repo: $repo"
  repo=$(main_root "$(jj -R "$repo" workspace root 2>/dev/null || echo "$repo")")

  local repo_name; repo_name=$(basename "$repo")

  # A workspace jj still tracks whose checkout is gone from disk.
  local dead=()
  while IFS= read -r ws; do
    [[ -z "$ws" || "$ws" == "default" ]] && continue
    [[ -d "$WS_ROOT/$repo_name/$(slug "$ws")" ]] || dead+=("$ws")
  done < <(jjq "$repo" workspace list -T 'self.name() ++ "\n"' 2>/dev/null | sed '/^$/d')

  local divergent
  divergent=$(jjq "$repo" log \
    -r 'divergent() & mutable() & ~remote_bookmarks(remote=origin) & ~working_copies()' \
    --no-graph -T 'change_id.short() ++ " " ++ description.first_line() ++ "\n"' 2>/dev/null | sed '/^$/d')

  local conflicted
  conflicted=$(jjq "$repo" bookmark list --conflicted 2>/dev/null || true)

  local work=0
  if (( ${#dead[@]} )); then
    work=1; echo "workspaces to forget (checkout gone):"
    printf '  %s\n' "${dead[@]}"; echo
  fi
  if [[ -n "$divergent" ]]; then
    work=1; echo "divergent commits to abandon:"; sed 's/^/  /' <<<"$divergent"; echo
  fi
  if [[ -n "$conflicted" ]]; then
    echo "conflicted bookmarks (fix by hand):"; sed 's/^/  /' <<<"$conflicted"
    echo "  jj bookmark delete <name>   OR   jj bookmark track <name>@origin"; echo
  fi
  (( work )) || { echo "nothing to tidy."; return 0; }

  if [[ -t 0 ]]; then
    printf 'proceed? [y/N] '; read -r ans
    [[ "$ans" == [yY] ]] || { echo "aborted."; return 0; }
  fi

  local n=0
  for ws in "${dead[@]}"; do
    jjq "$repo" workspace forget "$ws" >/dev/null 2>&1 && ((n++)) || true
  done
  [[ -n "$divergent" ]] && jjq "$repo" abandon \
    'divergent() & mutable() & ~remote_bookmarks(remote=origin) & ~working_copies()' >/dev/null 2>&1
  echo "forgot $n workspace(s); abandoned divergent commits."
}

case "${1:-}" in
  new)            shift; cmd_new "$@" ;;
  rm|remove|kill) shift; cmd_rm "$@" ;;
  tidy)           shift; cmd_tidy "$@" ;;
  -h|--help|help|"")
    cat <<'EOF'
herdr-jj — jj-workspace-backed agent sessions for herdr

  herdr-jj new              pick a repo, then pick or name the work, then
                            pick a model tier (or loop) and a harness
  herdr-jj new --repo R --name N [--prompt P] \
              [--model opus|sonnet|haiku|loop] [--harness claude|pi] [--agent CMD]
  herdr-jj rm [path]        in an agent workspace: forget + delete + close it;
                            anywhere else: just close the herdr workspace
  herdr-jj tidy [repo]      sweep dead workspaces / divergent commits

The picker is one ranked list — running agents first, then idle workspaces, then
your local bookmarks by recency, then remote ones. Selecting a workspace attaches
to it (continuing its session); selecting a bookmark branches a new workspace off
it; typing a name that matches nothing starts fresh work.

--model picks opus/sonnet/haiku (or loop, the 3-agent planner/worker/judge
layout); --harness picks which CLI runs it: claude (Claude Code, default) or
pi. --agent gives an explicit full launch command and overrides both.

Checkouts live in ~/.herdr/workspaces/<repo>/<name>  ($HERDR_JJ_ROOT to override).
Agent command: $HERDR_JJ_AGENT (default: claude --dangerously-skip-permissions).
Harness: $HERDR_JJ_HARNESS (default: claude).

herdr owns the UI — sidebar, agent state, attention queue:
  prefix+shift+a  new / attach agent     prefix+w         workspace picker
  prefix+shift+d  remove this workspace  prefix+alt+1..9  focus an agent
  prefix+shift+y  tidy                   prefix+g         goto
EOF
    ;;
  *) die "unknown command: $1 (try --help)" ;;
esac
