#!/usr/bin/env bash
# Merge pi/settings.json (tracked) + pi/settings.local.json (gitignored) into
# ~/.pi/agent/settings.json, preserving pi-managed fields from the existing file.
#
# Model IDs come from config/bedrock.env (single source of truth).
# pi/settings.local.json only needs provider + model pattern — no model IDs.
#
# Run after editing pi/settings.json or config/bedrock.env:
#   bin/pi-settings-sync

set -euo pipefail

BASE="$(cd "$(dirname "$0")/.." && pwd)"
PI_BASE="$BASE/pi/settings.json"
PI_LOCAL="$BASE/pi/settings.local.json"
BEDROCK_ENV="$BASE/config/bedrock.env"
PI_OUT="$HOME/.pi/agent/settings.json"

if [ ! -f "$PI_BASE" ]; then
  echo "error: $PI_BASE not found" >&2
  exit 1
fi

# Load model IDs from bedrock.env when present.
BEDROCK_OPUS_MODEL=""
BEDROCK_SONNET_MODEL=""
if [ -f "$BEDROCK_ENV" ]; then
  # shellcheck source=/dev/null
  source "$BEDROCK_ENV"
fi

mkdir -p "$(dirname "$PI_OUT")"

BEDROCK_OPUS_MODEL="$BEDROCK_OPUS_MODEL" \
BEDROCK_SONNET_MODEL="$BEDROCK_SONNET_MODEL" \
node -e "
  const fs = require('fs');
  const base   = JSON.parse(fs.readFileSync('$PI_BASE',  'utf8'));
  const local  = fs.existsSync('$PI_LOCAL')
                   ? JSON.parse(fs.readFileSync('$PI_LOCAL', 'utf8'))
                   : {};
  const existing = fs.existsSync('$PI_OUT')
                     ? JSON.parse(fs.readFileSync('$PI_OUT', 'utf8'))
                     : {};

  const opusModel   = process.env.BEDROCK_OPUS_MODEL;
  const sonnetModel = process.env.BEDROCK_SONNET_MODEL;

  // Inject model IDs from bedrock.env into local overrides.
  // local already has defaultProvider + enabledModels; we add the model fields.
  if (sonnetModel) {
    local.defaultModel = 'amazon-bedrock/' + sonnetModel;
    if (local.subagents) {
      local.subagents.defaultModel = 'amazon-bedrock/' + sonnetModel;
      const overrides = local.subagents.agentOverrides ?? {};
      for (const role of ['scout', 'worker', 'reviewer']) {
        if (overrides[role]) overrides[role].model = 'amazon-bedrock/' + sonnetModel;
      }
    }
  }
  if (opusModel && local.subagents?.agentOverrides?.oracle) {
    local.subagents.agentOverrides.oracle.model = 'amazon-bedrock/' + opusModel;
  }

  // Preserve pi-managed fields from the live file so pi doesn't re-show
  // changelogs, re-generate theme names, etc.
  const piManaged = ['lastChangelogVersion', 'theme', 'trackingId', 'enableAnalytics'];
  const preserved = {};
  for (const k of piManaged) {
    if (existing[k] !== undefined) preserved[k] = existing[k];
  }

  const merged = { ...base, ...local, ...preserved };
  fs.writeFileSync('$PI_OUT', JSON.stringify(merged, null, 2) + '\n');
"

if [ -f "$PI_LOCAL" ]; then
  echo "merged pi/settings.json + pi/settings.local.json → $PI_OUT"
else
  echo "no pi/settings.local.json found — written from base only → $PI_OUT"
  echo "hint: create pi/settings.local.json with { \"defaultProvider\": \"amazon-bedrock\", \"enabledModels\": [\"eu.anthropic.claude-*\"] }"
fi
