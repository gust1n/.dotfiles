#!/usr/bin/env bash
# Pick a URL from the calling pane's content and open it.
# Popups get HERDR_ACTIVE_PANE_ID (the tiled pane below), not HERDR_PANE_ID.
#
# fzf opens at once and URLs stream in from two reads:
# 1. `--raw` is instant. It returns the scrollback of a shell pane, or the
#    screen of an alternate-screen app (Claude Code, less, vim).
# 2. The formatted read also rebuilds history for agent panes, up to 1000
#    lines. That takes 1-3 s, so its URLs arrive after fzf is open.

set -uo pipefail

_notify() { herdr notification show "URL Picker" --body "$*" 2>/dev/null || true; }

command -v herdr >/dev/null || exit 0
command -v fzf >/dev/null || { _notify "fzf not found"; exit 1; }

pane_id="${HERDR_ACTIVE_PANE_ID:-}"
if [[ -z "$pane_id" ]]; then
  pane_id=$(herdr pane current --current 2>/dev/null \
    | jq -r '.result.pane.pane_id // empty' 2>/dev/null)
fi
[[ -n "$pane_id" ]] || exit 0

# Newest first, each URL once. A trailing ")" is dropped when it has no "(" in
# the URL to match, so "(see https://x.io/a)" yields https://x.io/a.
_extract() {
  sed -E $'s/\x1b\\[[0-9;:?]*[A-Za-z]//g; s/\x1b\\][^\x07\x1b]*(\x07|\x1b\\\\)//g' \
    | grep -oE 'https?://(localhost|[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)+)([:/][a-zA-Z0-9._%+~:/?#@!$&()*,;=-]*[a-zA-Z0-9/=_~#)-])?' \
    | awk '
      { o = gsub(/\(/, "("); c = gsub(/\)/, ")"); while (c > o && /\)$/) { $0 = substr($0, 1, length($0) - 1); c-- } }
      !seen[$0]++ { u[n++] = $0 }
      END { while (n) print u[--n] }'
}

found=$(mktemp)
trap 'rm -f "$found"' EXIT

# No --height: full-screen fzf opens at once. Inline mode first scrolls the
# popup to make room and waits for the terminal to report the cursor position.
# fzf reads from a process substitution, which bash does not wait for, so the
# popup closes on selection while the slow read still runs. The producer holds
# no terminal fds and dies on SIGPIPE at its next write.
selected=$(
  fzf --prompt="Open URL> " --reverse --no-multi --exit-0 < <(
    {
      herdr pane read "$pane_id" --source recent-unwrapped --raw --lines 2000 | _extract
      herdr pane read "$pane_id" --source recent-unwrapped --lines 2000 | _extract
    } </dev/null 2>/dev/null | awk '!seen[$0]++ { print; fflush() }' | tee "$found"
  )
)
status=$?

if [[ -z "$selected" ]]; then
  # Exit 1 is empty input (--exit-0) or Enter with no match; Esc is 130.
  [[ $status -eq 1 && ! -s "$found" ]] && _notify "No URLs found"
  exit 0
fi
if command -v open >/dev/null; then open "$selected"; else xdg-open "$selected"; fi
