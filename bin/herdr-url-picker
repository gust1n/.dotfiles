#!/usr/bin/env bash
# Pick a URL from the calling pane's content and open it.
# Popups get HERDR_ACTIVE_PANE_ID (the tiled pane below), not HERDR_PANE_ID.
# Reads both `visible` (captures Claude Code / alternate-screen apps) and
# `recent-unwrapped` (captures regular terminal scrollback history).

set -uo pipefail

_notify() { herdr notification show "URL Picker" --body "$*" 2>/dev/null || true; }

command -v herdr >/dev/null || exit 0
command -v fzf >/dev/null || { _notify "fzf not found"; exit 1; }

pane_id="${HERDR_ACTIVE_PANE_ID:-}"
if [[ -z "$pane_id" ]]; then
  pane_id=$(herdr pane current --current 2>/dev/null \
    | jq -r '.result.pane.pane_id // empty' 2>/dev/null)
fi
[[ -n "$pane_id" ]] || exit 0

# Newest first, each URL once. A trailing ")" is dropped when it has no "(" in
# the URL to match, so "(see https://x.io/a)" yields https://x.io/a.
urls=$(
  {
    herdr pane read "$pane_id" --source recent-unwrapped --lines 2000 2>/dev/null
    herdr pane read "$pane_id" --source visible 2>/dev/null
  } | grep -oE 'https?://(localhost|[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)+)([:/][a-zA-Z0-9._%+~:/?#@!$&()*,;=-]*[a-zA-Z0-9/=_~#)-])?' \
    | awk '
      { o = gsub(/\(/, "("); c = gsub(/\)/, ")"); while (c > o && /\)$/) { $0 = substr($0, 1, length($0) - 1); c-- } }
      !seen[$0]++ { u[n++] = $0 }
      END { while (n) print u[--n] }'
)

[[ -n "$urls" ]] || { _notify "No URLs found"; exit 0; }

# No --height: full-screen fzf opens at once. Inline mode first scrolls the
# popup to make room and waits for the terminal to report the cursor position.
selected=$(fzf --prompt="Open URL> " --reverse --no-multi <<<"$urls")

[[ -n "$selected" ]] || exit 0
if command -v open >/dev/null; then open "$selected"; else xdg-open "$selected"; fi
