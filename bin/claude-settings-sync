#!/usr/bin/env bash
# Generate ~/.claude/settings.json from claude/settings.json (tracked template)
# + config/bedrock.env (model IDs), preserving Claude-managed fields from the
# existing live file.
#
# Run after editing claude/settings.json or config/bedrock.env:
#   bin/claude-settings-sync

set -euo pipefail

BASE="$(cd "$(dirname "$0")/.." && pwd)"
TEMPLATE="$BASE/claude/settings.json"
BEDROCK_ENV="$BASE/config/bedrock.env"
OUT="$HOME/.claude/settings.json"

if [ ! -f "$TEMPLATE" ]; then
  echo "error: $TEMPLATE not found" >&2
  exit 1
fi

# Load model IDs from bedrock.env when present.
BEDROCK_OPUS_MODEL=""
BEDROCK_SONNET_MODEL=""
if [ -f "$BEDROCK_ENV" ]; then
  # shellcheck source=/dev/null
  source "$BEDROCK_ENV"
fi

mkdir -p "$(dirname "$OUT")"

BEDROCK_OPUS_MODEL="$BEDROCK_OPUS_MODEL" \
BEDROCK_SONNET_MODEL="$BEDROCK_SONNET_MODEL" \
node -e "
  const fs = require('fs');
  const template = JSON.parse(fs.readFileSync('$TEMPLATE', 'utf8'));
  const existing = fs.existsSync('$OUT')
                     ? JSON.parse(fs.readFileSync('$OUT', 'utf8'))
                     : {};

  const opusModel   = process.env.BEDROCK_OPUS_MODEL;
  const sonnetModel = process.env.BEDROCK_SONNET_MODEL;

  // Inject model IDs from bedrock.env into the env block.
  template.env = template.env ?? {};
  if (opusModel)   template.env.ANTHROPIC_DEFAULT_OPUS_MODEL   = opusModel;
  if (sonnetModel) template.env.ANTHROPIC_DEFAULT_SONNET_MODEL = sonnetModel;

  // Preserve fields that Claude Code writes back to the file so we don't
  // clobber the user's choices on each sync.
  const claudeManaged = ['model', 'effortLevel', 'theme', 'attribution'];
  for (const k of claudeManaged) {
    if (existing[k] !== undefined) template[k] = existing[k];
  }

  fs.writeFileSync('$OUT', JSON.stringify(template, null, 2) + '\n');
"

echo "generated ~/.claude/settings.json from claude/settings.json + bedrock.env"
