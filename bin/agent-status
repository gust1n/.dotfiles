#!/usr/bin/env bash
# Called by Claude Code hooks to update agent status icon on the tmux session.
# Usage: agent-status working|waiting|done|clear
set -euo pipefail

[[ -z "${TMUX:-}" ]] && exit 0

action="${1:-}"
case "$action" in
  working) icon=$(printf '\xef\x80\x93') ;;  # nf-fa-cog U+F013
  waiting) icon=$(printf '\xef\x83\xa5') ;;  # nf-fa-comment U+F0E5
  done)    icon=$(printf '\xef\x80\x8c') ;;  # nf-fa-check U+F00C
  clear)   icon="" ;;
  *)       exit 1 ;;
esac

session=$(tmux list-panes -t "${TMUX_PANE:-}" -F '#{session_name}' 2>/dev/null | head -1)
[[ -z "$session" ]] && exit 0

tmux set-option -t "$session" @agent_status "$icon" 2>/dev/null || true

if [[ "$action" == "working" ]]; then
  tmux set-option -t "$session" @agent_last_active "$(date +%s)" 2>/dev/null || true
fi

if [[ "$action" == "done" || "$action" == "waiting" ]]; then
  tmux set-hook -t "$session" client-session-changed \
    "set-option @agent_status ''; set-hook -u client-session-changed" 2>/dev/null || true
fi

# Force status refresh so session bar updates immediately
tmux refresh-client -S 2>/dev/null || true
