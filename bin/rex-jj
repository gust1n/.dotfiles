#!/usr/bin/env bash
# rex-jj — jj-workspace-backed agent sessions for Rex. A copy of herdr-jj with
# the herdr calls replaced; the jj side is the same.
#
# Each agent gets its own jj workspace (a second working copy of the same repo)
# so parallel agents never touch each other's files, and the MAIN checkout stays
# yours for reading and hand-editing. Each workspace opens as its own Rex
# session.
#
#   new      pick a repo, then one ranked list: attach to an existing workspace,
#            branch off one of your bookmarks, or type a name for fresh work.
#            Idempotent — a name that already has a workspace attaches to it,
#            which is why there is no separate resume/ls command.
#   agents   every agent running in Rex with its state; Enter jumps to it
#   ask      send a message to a workspace's agent, wait, print its reply
#   reply    wait for a workspace's agent to finish, print its reply
#   rm       forget a jj workspace, delete it, kill its Rex session
#   tidy     sweep dead workspaces, divergent commits, conflicted bookmarks
#
# Agent state comes from the OSC 7501 reports of bin/rex-agent-status.

set -uo pipefail

CODE_DIR="${CODE_DIR:-$HOME/Code}"
# Keep agent checkouts out of the repos themselves: no .gitignore entries, and
# an agent's tooling can't wander into a sibling workspace. The same dir as
# herdr-jj, so both see the same workspaces.
WS_ROOT="${REX_JJ_ROOT:-$HOME/.herdr/workspaces}"
AGENT_CMD="${REX_JJ_AGENT:-claude --dangerously-skip-permissions}"
AGENT_PROGRAMS='^(claude|agy|codex)$'
BACKGROUND=0   # new --background: leave the app where it is
IN_TAB=0       # new --tab: open in a tab of $REX_SESSION, not a new session

# Model behind the "flash" tier in the picker: agy for throughput.
FLASH_MODEL="${FLASH_MODEL:-gemini-3.8-flash-medium}"

# --- plumbing ---------------------------------------------------------------

die() { echo "error: $*" >&2; exit 1; }

# Popups close the instant the script exits, taking the error message with it.
die_pause() {
  echo "error: $*" >&2
  [[ -t 0 ]] && { printf '\npress enter to close...'; read -r _; }
  exit 1
}

need() {
  for c in "$@"; do
    command -v "$c" >/dev/null || die_pause "$c not found on PATH"
  done
}

# No --height: full-screen fzf opens at once, without scrolling the popup.
_fzf() { fzf --prompt="$1> " --reverse; }

# fzf over "<value>TAB<display>" lines: only the display half is shown and
# searched, but the full line comes back so the caller can recover the value.
# An unmatched query is itself a valid answer (a name for new work), and
# --no-sort preserves the ranking we fed in.
_fzf_or_new() {
  local out query match
  out=$(fzf --prompt="$1> " --reverse --no-sort \
            --delimiter='\t' --with-nth=2.. --nth=2.. \
            --print-query 2>/dev/null) || true
  query=$(sed -n '1p' <<<"$out")
  match=$(sed -n '2p' <<<"$out")
  if [[ -n "$match" ]]; then printf '%s\n' "$match"
  elif [[ -n "$query" ]]; then printf '%s\n' "$query"
  else return 1; fi
}

# "3d" / "2w" / "5mo" — how long ago, from a unix timestamp. Empty if unknown.
ago() {
  local ts="$1" now d
  [[ -z "$ts" || "$ts" == "0" ]] && return
  now=$(date +%s)
  d=$(( (now - ts) / 86400 ))
  (( d < 0 )) && d=0
  if   (( d == 0 ));  then printf 'today'
  elif (( d < 7 ));   then printf '%dd' "$d"
  elif (( d < 60 ));  then printf '%dw' "$(( d / 7 ))"
  else                     printf '%dmo' "$(( d / 30 ))"
  fi
}

# Path-safe slug. Bookmarks may contain '/' ("gustin/fix-auth"); paths shouldn't.
slug() {
  local s
  s=$(printf '%s' "$1" | tr -c 'A-Za-z0-9' '-' | tr 'A-Z' 'a-z' | tr -s '-')
  s="${s#-}"; s="${s%-}"
  printf '%s\n' "${s:-workspace}"
}

# Repo roots under $CODE_DIR, as paths relative to it. Anything containing a
# .git or .jj counts, so plain-git repos are offered too (ensure_jj colocates
# jj into them on first use).
_discover_repos() {
  local d
  { if command -v fd >/dev/null; then
      fd --no-ignore --hidden --follow --type d --max-depth 6 \
         '^\.git$|^\.jj$' "$CODE_DIR" 2>/dev/null
    else
      find "$CODE_DIR" -maxdepth 6 \( -name .git -o -name .jj \) 2>/dev/null
    fi
  } | while IFS= read -r d; do
        d="${d%/}"                    # fd emits a trailing slash on dirs
        d="${d%/.git}"; d="${d%/.jj}" # strip the marker, leaving the repo root
        # Skip vendored/nested checkouts: tmux plugins, node_modules, backups,
        # agent workspaces. Without this, one repo's submodules bury the list.
        case "$d" in
          *"/.herdr/"*|*"/node_modules/"*|\
          *"/plugins/"*|*"/vendor/"*|*"/bak/"*|*"/.git/"*|*"/.terraform/"*) continue ;;
        esac
        printf '%s\n' "${d#"$CODE_DIR"/}"
      done | sort -u
}

# A jj repo has exactly one MAIN workspace, which stores .jj/repo as the store
# DIRECTORY. Every secondary (agent) workspace stores .jj/repo as a FILE holding
# a relative path to that store. This is how we tell the two apart anywhere,
# without caring where on disk the checkout lives — the same test agent-guard
# uses to decide whether to sandbox a session.
is_main_ws() { [[ -d "$1/.jj/repo" ]]; }
is_agent_ws() { [[ -f "$1/.jj/repo" ]]; }

# Resolve any workspace path to its repo's MAIN root by following .jj/repo.
main_root() {
  local ws="$1" ptr
  is_main_ws "$ws" && { printf '%s\n' "$ws"; return; }
  ptr=$(cat "$ws/.jj/repo" 2>/dev/null) || { printf '%s\n' "$ws"; return; }
  # Pointer is relative to .jj/ and ends in /repo: strip 'repo' then '.jj'.
  ( cd "$ws/.jj/$ptr/../.." 2>/dev/null && pwd -P ) || printf '%s\n' "$ws"
}

# Read-only queries against a repo we're not standing in. --ignore-working-copy
# keeps us from snapshotting someone else's working copy as a side effect.
jjq() { jj --ignore-working-copy -R "$1" "${@:2}"; }
rev_exists() { jjq "$1" log -r "$2" --no-graph --limit 1 >/dev/null 2>&1; }

ensure_jj() {
  local repo="$1"
  [[ -d "$repo/.jj" ]] || jj git init --colocate "$repo" >/dev/null 2>&1 \
    || die_pause "could not initialise jj in $repo"
  jjq "$repo" git import >/dev/null 2>&1 || true
}

# Prefer resuming published work over starting fresh: an existing bookmark of
# this name (remote first) means "continue that", not "branch off trunk".
base_rev() {
  local repo="$1" name="$2"
  for r in "${name}@origin" "$name" 'trunk()'; do
    rev_exists "$repo" "$r" && { printf '%s\n' "$r"; return; }
  done
  printf '@\n'
}

# --- rex side ---------------------------------------------------------------

# One line per terminal pane in every session, tab-separated:
#   session_id session_label window_id window_label block_id program cwd
#   state app msg since title
# program and cwd are the pane's foreground process. state, app, msg and since
# (unix time of the last report) are the pane's root status record. title is
# the terminal title without a leading spinner glyph; Claude sets it to the
# session name. An empty field is "-", because read merges empty tab-separated
# fields. One Lua script does the whole scan in a single rex process: a CLI
# call per pane, each piped through jq, took over a second.
rex_panes() {
  rex do - 2>/dev/null <<'LUA'
local T = "com.superlogical.terminal"
-- updated_at is local time with an offset, such as 2026-10-21T12:13:10.5+02:00.
local function epoch(ts)
  if not ts then return nil end
  local y, mo, d, h, mi, s, z = ts:match("^(%d+)-(%d+)-(%d+)T(%d+):(%d+):(%d+)[%.%d]*(.*)$")
  if not y then return nil end
  local off = 0
  local sg, oh, om = z:match("^([+-])(%d%d):(%d%d)$")
  if sg then off = (sg == "-" and -1 or 1) * (tonumber(oh) * 3600 + tonumber(om) * 60) end
  local t = { year = y, month = mo, day = d, hour = h, min = mi, sec = s, isdst = false }
  -- os.time reads the table as local time; shift it to read it as UTC.
  local now = os.time()
  local utc_skew = os.time(os.date("!*t", now)) - now
  return os.time(t) - utc_skew - off
end

local function f(v) v = v and tostring(v) or "" ; v = v:gsub("[\t\n]", " ") ; return v == "" and "-" or v end

for _, s in ipairs((rex.call("session.list") or {}).sessions or {}) do
  local sid = s.session_id
  -- A script's connection only reaches the sessions it is attached to.
  rex.session.attach{ session_id = sid }
  local labels = {}
  for _, w in ipairs((rex.session.view{ session_id = sid } or {}).windows or {}) do
    labels[w.window_id] = w.label
  end
  for _, b in ipairs((rex.session.list_blocks{ session_id = sid } or {}).blocks or {}) do
    if b.creator_name == T and b.placement == "placed" then
      local a = { session_id = sid, block_id = b.block_id }
      local p = rex.block.call(T, "process", a) or {}
      local fg = p.foreground or {}
      local anc = (p.ancestors or {})[1] or {}
      local rec = {}
      for _, r in ipairs((rex.block.call(T, "program_status", a) or {}).records or {}) do
        if r.id == nil then rec = r break end
      end
      local title = ((rex.block.call(T, "title", a) or {}).title or "")
      title = title:gsub("^[^%w~/]+%s*", "")
      io.write(table.concat({ f(sid), f(s.label), f(b.window_id), f(labels[b.window_id]), f(b.block_id),
        f(fg.name), f(fg.cwd or anc.cwd), f(rec.state), f(rec.effective_app or rec.app), f(rec.msg),
        f(epoch(rec.updated_at)), f(title) }, "\t"), "\n")
    end
  end
end
LUA
}

# Sessions with a pane at this path. Processes report fully-resolved cwds
# (/private/tmp/… on macOS), so compare the resolved path too.
ws_ids_for_cwd() {
  local path="$1" real
  real=$(cd "$path" 2>/dev/null && pwd -P) || real="$path"
  rex_panes | awk -F'\t' -v p="$real" -v q="$path" '$7 == p || $7 == q { print $1 }' | sort -u
}

ws_id_for_cwd() { ws_ids_for_cwd "$1" | head -1; }

# Show a session in the app, optionally at one pane. Without -C, rex picks the
# app when exactly one is connected.
show() {
  local sid="$1" bid="${2:-}"
  [[ -n "$bid" ]] && rex focus -s "$sid" "$bid" >/dev/null 2>&1
  local err
  err=$(rex do session.select session_id="$sid" 2>&1 >/dev/null) || {
    echo "warning: could not switch the app to $sid: $err" >&2
    [[ -t 0 ]] && { printf '\npress enter to close...'; read -r _; }
  }
  return 0
}

# Prints "<session_id> <block_id>" of a new session or tab, or FOCUSED when one
# is already open at the path.
open_ws() {
  local path="$1" label="$2" out id
  id=$(ws_id_for_cwd "$path")
  if [[ -n "$id" ]]; then
    (( BACKGROUND )) || show "$id"
    printf '%s\n' "FOCUSED"
    return
  fi
  if (( IN_TAB )); then
    out=$(rex window new -s "$REX_SESSION" "$label" -c "$path" \
            --focus="$( (( BACKGROUND )) && echo false || echo true )" --json 2>&1) \
      || die_pause "rex window new failed: $out"
    jq -r --arg s "$REX_SESSION" '"\($s) \(.block_ids[0])"' <<<"$out" 2>/dev/null
    return
  fi
  out=$(rex new "$label" -c "$path" --json 2>&1) \
    || die_pause "rex new failed: $out"
  id=$(jq -r '.session_id // empty' <<<"$out")
  (( BACKGROUND )) || show "$id"
  jq -r '"\(.session_id) \(.initial_windows[0].block_ids[0])"' <<<"$out" 2>/dev/null
}

# Type a command into the pane's shell, so the shell stays when it exits.
run_in() { rex send -s "$1" -b "$2" "$3" >/dev/null && rex send-key -s "$1" -b "$2" enter >/dev/null; }

# Type a message into an agent. Bracketed paste keeps a multi-line message in
# one prompt; the pause lets the agent finish the paste before Enter.
send_msg() {
  rex send -s "$1" -b "$2" $'\e[200~'"$3"$'\e[201~' >/dev/null || return 1
  sleep 0.5
  rex send-key -s "$1" -b "$2" enter >/dev/null
}

pane_state() {
  rex block call -s "$1" -b "$2" program_status 2>/dev/null \
    | jq -r '[.records[] | select(.id == null)][0] | [.state // "", .msg // ""] | @tsv'
}

# claude reports idle once it can take input (SessionStart in rex-agent-status).
wait_idle() {
  local sid="$1" bid="$2" i
  for (( i = 0; i < 120; i++ )); do
    [[ "$(rex block call -s "$sid" -b "$bid" program_status 2>/dev/null \
          | jq -r '[.records[] | select(.id == null)][0].state // ""')" == idle ]] && return 0
    sleep 0.5
  done
  return 1
}

# Launch the agent in a pane. With a prompt, wait until the agent is ready, then
# type the prompt. Without one, hand the user a live terminal.
launch() {
  local sid="$1" bid="$2" prompt="${3:-}"
  run_in "$sid" "$bid" "$AGENT_CMD"
  [[ -z "$prompt" ]] && return
  wait_idle "$sid" "$bid" \
    || echo "warning: agent did not report ready; typing the prompt anyway" >&2
  send_msg "$sid" "$bid" "$prompt" \
    || echo "warning: could not submit the prompt; the agent is waiting for input" >&2
}

# --- talking to agents ------------------------------------------------------

# A workspace's resolved path, as the agent's process reports it, from a path or
# a workspace name. A name must match exactly one repo under $WS_ROOT.
ws_path() {
  local arg="$1" matches
  [[ -d "$arg" ]] && { (cd "$arg" && pwd -P); return; }
  matches=$(printf '%s\n' "$WS_ROOT"/*/"$(slug "$arg")" | while read -r d; do [[ -d "$d" ]] && echo "$d"; done)
  case $(grep -c . <<<"$matches") in
    1) (cd "$matches" && pwd -P) ;;
    0) die "no workspace named $arg under $WS_ROOT" ;;
    *) die "$arg matches several repos; pass the path:"$'\n'"$matches" ;;
  esac
}

# "<session_id> <block_id>" of the agent running in a workspace.
agent_pane() {
  local path="$1" real
  real=$(cd "$path" 2>/dev/null && pwd -P) || real="$path"
  rex_panes | awk -F'\t' -v p="$real" -v q="$path" -v re="$AGENT_PROGRAMS" \
    '($7 == p || $7 == q) && $6 ~ re { print $1 " " $5; exit }'
}

# The agent's last reply. Claude writes its transcript to
# ~/.claude/projects/<cwd with every non-alphanumeric as ->/<session>.jsonl.
# Agents without one fall back to the screen.
last_reply() {
  local sid="$1" bid="$2" path="$3" dir f
  dir="$HOME/.claude/projects/$(printf '%s' "$path" | sed 's/[^A-Za-z0-9]/-/g')"
  f=$(ls -t "$dir"/*.jsonl 2>/dev/null | head -1)
  if [[ -n "$f" ]]; then
    tail -n 500 "$f" | jq -rn '[inputs | select(.type == "assistant")
      | .message.content[]? | select(.type == "text") | .text] | last // empty' 2>/dev/null
  else
    rex capture -s "$sid" -b "$bid" --trim
  fi
}

# Wait until the agent stops working, then print its reply. Exits 2 with the
# reason when the agent is blocked on a permission or a question.
await_reply() {
  local sid="$1" bid="$2" path="$3" timeout="$4" state msg i
  for (( i = 0; i < timeout * 2; i++ )); do
    IFS=$'\t' read -r state msg < <(pane_state "$sid" "$bid")
    case "$state" in
      working) sleep 0.5 ;;
      blocked) echo "blocked: ${msg:-waiting for input}"; return 2 ;;
      *)       last_reply "$sid" "$bid" "$path"; return 0 ;;
    esac
  done
  echo "still working after ${timeout}s; run rex-jj reply to keep waiting" >&2
  return 3
}

cmd_ask() {
  need rex jq
  local target="" msg="" timeout=1800
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --timeout) timeout="${2:-}"; shift 2 ;;
      *) if [[ -z "$target" ]]; then target="$1"; else msg="$1"; fi; shift ;;
    esac
  done
  [[ -n "$target" && -n "$msg" ]] || die "usage: rex-jj ask <workspace> <message>"
  local path pane sid bid i
  path=$(ws_path "$target") || exit 1
  pane=$(agent_pane "$path")
  [[ -n "$pane" ]] || die "no agent running in $path"
  read -r sid bid <<<"$pane"
  send_msg "$sid" "$bid" "$msg" || die "could not type into $sid"
  # Wait for the agent to pick the message up, so the old state isn't read as
  # the reply.
  for (( i = 0; i < 30; i++ )); do
    [[ "$(pane_state "$sid" "$bid" | cut -f1)" == working ]] && break
    sleep 0.5
  done
  await_reply "$sid" "$bid" "$path" "$timeout"
}

cmd_reply() {
  need rex jq
  local target="" timeout=1800
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --timeout) timeout="${2:-}"; shift 2 ;;
      *) target="$1"; shift ;;
    esac
  done
  [[ -n "$target" ]] || die "usage: rex-jj reply <workspace>"
  local path pane sid bid
  path=$(ws_path "$target") || exit 1
  pane=$(agent_pane "$path")
  [[ -n "$pane" ]] || die "no agent running in $path"
  read -r sid bid <<<"$pane"
  await_reply "$sid" "$bid" "$path" "$timeout"
}

# --- the picker -------------------------------------------------------------

# One ranked list of everything you might want to work on in this repo, most
# likely first. Selecting an existing workspace attaches to it; selecting a
# bookmark branches a new workspace off it; typing a new name starts fresh.
#
# Ranking matters more than filtering here: a repo can have 150+ remote
# bookmarks (dependabot, every colleague's branch), but a LOCAL bookmark means
# you have touched it, which is the signal that separates your work from theirs.
# Nothing is hidden — fzf substring matching keeps a colleague's branch one
# keystroke away — it just sorts last.
#
#   1. live workspaces   (an agent is running there)
#   2. idle workspaces   (checkout on disk, no agent)
#   3. your bookmarks    (local == you've touched it), newest first
#   4. remote bookmarks  (colleagues, bots), newest first
#
# Prints the chosen name on stdout. Column 1 is the value; the rest is display.
pick_target() {
  local repo="$1" repo_name
  repo_name=$(basename "$repo")

  # Which workspace dirs exist, and which have a live agent (one snapshot).
  local live_cwds
  live_cwds=$(rex_panes | awk -F'\t' -v re="$AGENT_PROGRAMS" '$6 ~ re { print $7 }')

  # "<name>\t<unix-ts>" for one set of bookmarks, newest first, deduped.
  # jj emits a row per local + per remote, so several rows can share a name;
  # sorting by name then age and keeping the first row per name dedupes them.
  # $1 = a jj condition selecting which bookmarks to include. The whole line is
  # suppressed when it doesn't match, otherwise a filtered-out bookmark would
  # still emit a bare "\t<timestamp>" row.
  marks() {
    jjq "$repo" bookmark list ${2:+--all-remotes} -T '
        if('"$1"',
           self.name() ++ "\t"
           ++ if(self.normal_target(),
                 self.normal_target().committer().timestamp().format("%s"), "0")
           ++ "\n",
           "")' 2>/dev/null \
      | sed '/^$/d' \
      | sort -t"$(printf '\t')" -k1,1 -k2,2nr | awk -F'\t' '!seen[$1]++' \
      | sort -t"$(printf '\t')" -k2,2nr
  }

  local seen_names="" d name real
  local picked
  picked=$( {
      # Value "+" is a sentinel: chosen from the list rather than typed, so ask
      # for the name instead of silently doing nothing.
      printf '+\t+ new agent  (or type a name here)\n'

      # 1/2. Workspaces on disk — live ones first. Selecting one attaches.
      for d in "$WS_ROOT/$repo_name"/*; do
        [[ -d "$d" ]] || continue
        is_agent_ws "$d" || continue
        name=$(basename "$d")
        real=$(cd "$d" 2>/dev/null && pwd -P) || real="$d"
        if grep -qxF -e "$real" -e "$d" <<<"$live_cwds"; then
          printf '0\t%s\t%-32s %s\n' "$name" "● $name" "agent"
        else
          printf '1\t%s\t%-32s %s\n' "$name" "○ $name" "workspace"
        fi
      done | sort -t"$(printf '\t')" -k1,1n | cut -f2-

      # 3. Your bookmarks (a local bookmark == you've touched it), newest first.
      # 4. Everyone else's (remote and untracked): colleagues, dependabot.
      # A workspace listed above already covers its bookmark, so skip those.
      # Names already shown (as a workspace, or in an earlier group) are skipped,
      # so nothing appears twice.
      seen_names=$(printf '%s\n' "$WS_ROOT/$repo_name"/* | xargs -n1 basename 2>/dev/null)
      emit_marks() {   # $1 = jj condition, $2 = label, $3 = --all-remotes?
        local nm ts
        while IFS=$'\t' read -r nm ts; do
          [[ -z "$nm" ]] && continue
          grep -qxF "$nm" <<<"$seen_names" && continue
          seen_names+=$'\n'"$nm"
          printf '%s\t%-32s %s\n' "$nm" "  $nm" "$2${ts:+ · $(ago "$ts")}"
        done < <(marks "$1" "${3:-}")
      }
      emit_marks 'true' local
      emit_marks 'self.remote() && !self.tracked()' origin remotes
    } | _fzf_or_new "work on" ) || return 1

  # Selected a row -> take the hidden value field; typed a name -> it has no tab.
  picked="${picked%%$'\t'*}"

  if [[ "$picked" == "+" ]]; then
    printf 'name for the new work: ' >&2
    read -r picked || return 1
    picked="${picked#"${picked%%[![:space:]]*}"}"   # trim leading space
    picked="${picked%"${picked##*[![:space:]]}"}"   # trim trailing space
    [[ -z "$picked" ]] && return 1
  fi

  printf '%s\n' "$picked"
}

# --- model picker -----------------------------------------------------------

# Interactive model-tier prompt. Esc or empty input → opus (default).
# Returns a bare tier keyword: opus, sonnet, or flash.
pick_model() {
  local choice
  choice=$(printf '%s\n' \
      'opus    planner / orchestrator' \
      'sonnet  worker / balanced' \
      'flash   gemini flash / throughput (agy)' \
    | fzf --prompt='model> ' --reverse --no-sort --no-multi \
          --header='↵ accept · esc = opus (default)' 2>/dev/null) || true
  local tier="${choice%% *}"  # first word; empty if Esc
  printf '%s\n' "${tier:-opus}"
}

# tier -> a launch command. "flash" means agy; every other tier means claude,
# which maps the opus/sonnet aliases to ANTHROPIC_DEFAULT_*_MODEL from mise.
build_agent_cmd() {
  case "$1" in
    flash)  printf 'agy --dangerously-skip-permissions --model %s\n' "$FLASH_MODEL" ;;
    sonnet) printf 'claude --dangerously-skip-permissions --model sonnet\n' ;;
    *)      printf 'claude --dangerously-skip-permissions --model opus\n' ;;
  esac
}

# --- commands ---------------------------------------------------------------

cmd_new() {
  local repo="" name="" prompt="" agent="" model_tier="" model_specified=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)    repo="${2:-}"; shift 2 ;;
      --name)    name="${2:-}"; shift 2 ;;
      --prompt)  prompt="${2:-}"; shift 2 ;;
      --background) BACKGROUND=1; shift ;;
      --tab)     IN_TAB=1; shift ;;
      --agent)   agent="${2:-}"; model_specified=1; shift 2 ;;
      --model)
        case "${2:-}" in
          opus|sonnet|flash) model_tier="$2" ;;
          *)                 agent="claude --dangerously-skip-permissions --model ${2:-}" ;;
        esac
        model_specified=1; shift 2 ;;
      *) shift ;;
    esac
  done
  # An explicit --agent command wins outright; otherwise a --model tier decides.
  if [[ -n "$agent" ]]; then
    AGENT_CMD="$agent"
  elif [[ -n "$model_tier" ]]; then
    AGENT_CMD=$(build_agent_cmd "$model_tier")
  fi

  (( IN_TAB )) && [[ -z "${REX_SESSION:-}" ]] && die "--tab needs REX_SESSION; run it inside Rex"

  local interactive=0
  [[ -z "$repo" || -z "$name" ]] && interactive=1

  if (( interactive )); then
    need rex jj jq fzf
    local rel
    rel=$(_discover_repos | _fzf "repo") || return 0
    [[ -z "$rel" ]] && return 0
    repo="$CODE_DIR/$rel"
  else
    need rex jj jq
  fi

  [[ -d "$repo" ]] || die_pause "no such repo: $repo"
  # Launching from inside an agent workspace should still base the new one off
  # the real repo, not nest workspaces inside a workspace.
  repo=$(main_root "$repo")
  ensure_jj "$repo"

  if (( interactive )); then
    name=$(pick_target "$repo") || return 0
    [[ -z "$name" ]] && return 0
    if (( ! model_specified )); then
      model_tier=$(pick_model)
      AGENT_CMD=$(build_agent_cmd "$model_tier")
    fi
  fi

  # A --tab agent shares the caller's Rex session, and Rex's SessionStart hook
  # tells every Claude to rename its session.
  if (( IN_TAB )) && [[ "$AGENT_CMD" == claude* ]]; then
    AGENT_CMD+=" --append-system-prompt 'You run in a tab of a Rex session that another agent owns. Never rename the Rex session.'"
  fi

  name="${name%@origin}"
  local repo_name path
  repo_name=$(basename "$repo")
  path="$WS_ROOT/$repo_name/$(slug "$name")"

  # Attach: the checkout already exists. If Rex still has it open we just show
  # it (open_ws returns FOCUSED); otherwise reopen and continue the previous
  # conversation rather than starting a blank one.
  if [[ -d "$path" ]]; then
    jj -R "$path" workspace update-stale >/dev/null 2>&1 || true
    local pane
    pane=$(open_ws "$path" "$repo_name/$name")
    if [[ "$pane" == "FOCUSED" ]]; then
      echo "attached to running agent: ${path/#$HOME/~}" >&2
      if [[ -n "$prompt" ]]; then
        pane=$(agent_pane "$path")
        [[ -n "$pane" ]] && send_msg $pane "$prompt"
      fi
      printf '%s\n' "$name"
      return 0
    fi
    [[ -z "$pane" ]] && die_pause "rex did not return a pane for $path"
    echo "reopened ${path/#$HOME/~}" >&2
    # Re-trust in case the workspace was cleaned or mise's cache expired.
    command -v mise >/dev/null 2>&1 && mise trust "$path" >/dev/null 2>&1 || true
    if [[ -n "$prompt" ]]; then
      launch $pane "$prompt"
    else
      # --continue resumes the prior session in this directory.
      run_in $pane "$AGENT_CMD --continue"
    fi
    printf '%s\n' "$name"
    return 0
  fi

  # Start from what origin has now, not what we last fetched. Non-fatal: offline
  # just means basing on the local trunk.
  jjq "$repo" git fetch >/dev/null 2>&1 \
    || echo "warning: jj git fetch failed; basing on the local trunk" >&2

  local base
  base=$(base_rev "$repo" "$name")

  mkdir -p "$(dirname "$path")" || die_pause "could not create $(dirname "$path")"
  # A stale entry under this name blocks `workspace add`; drop it first.
  jjq "$repo" workspace forget "$name" >/dev/null 2>&1 || true
  # `workspace add` writes a working copy, so it cannot run under
  # --ignore-working-copy. Run it inside the repo instead.
  local add_err
  add_err=$( cd "$repo" && jj workspace add --name "$name" -r "$base" "$path" 2>&1 ) \
    || die_pause "jj workspace add failed (name=$name base=$base): $add_err"

  # Trust mise config files in the workspace so the agent shell can find tools
  # immediately — without this, mise shows a trust prompt before claude starts.
  command -v mise >/dev/null 2>&1 && mise trust "$path" >/dev/null 2>&1 || true

  echo "created $path (base: $base)" >&2
  local pane
  pane=$(open_ws "$path" "$repo_name/$name")
  [[ -n "$pane" && "$pane" != "FOCUSED" ]] || die_pause "rex did not return a pane"
  launch $pane "$prompt"
  # stdout is for an agent that started this one: the name to pass to ask/reply.
  printf '%s\n' "$name"
}

# Not an agent workspace: kill the Rex session the popup was opened in.
close_this_workspace() {
  local id="${REX_SESSION:-}"
  [[ -z "$id" ]] && die_pause "no Rex session to close"

  local label
  label=$(rex session inspect "$id" --json 2>/dev/null | jq -r '.label // empty')

  # Killing ends every program in the session, so confirm when there is a
  # terminal to ask.
  if [[ -t 0 ]]; then
    printf 'kill session %s? [y/N] ' "${label:-$id}"
    read -r ans
    [[ "$ans" == [yY] ]] || { echo "aborted."; return 0; }
  fi
  rex kill "$id" >/dev/null 2>&1 \
    || die_pause "rex kill $id failed"
}

cmd_rm() {
  need rex jj jq
  local path="${1:-}"

  if [[ -z "$path" ]]; then
    # In an agent workspace, remove the checkout too; anywhere else fall back to
    # killing this Rex session, as herdr-jj does with herdr's close_workspace.
    if is_agent_ws "$(jj workspace root 2>/dev/null || echo /nonexistent)"; then
      path=$(jj workspace root)
    else
      close_this_workspace
      return $?
    fi
  fi

  path=$(cd "$path" 2>/dev/null && pwd -P) || die_pause "no such path: $path"
  is_main_ws "$path" && die_pause "refusing to remove the MAIN workspace ($path)"
  is_agent_ws "$path" || die_pause "not a jj workspace: $path"
  [[ "$path" == "$HOME" || "$path" == "/" ]] && die_pause "refusing to remove $path"

  # Warn about work that would vanish with the checkout.
  local unpushed
  unpushed=$(jj --ignore-working-copy -R "$path" log \
    -r 'mutable() & ~empty() & ::@ & ~(::remote_bookmarks())' --no-graph \
    -T 'description.first_line() ++ "\n"' 2>/dev/null | sed '/^$/d')
  if [[ -n "$unpushed" && -t 0 ]]; then
    echo "unpushed commits in this workspace:" >&2
    sed 's/^/  /' <<<"$unpushed" >&2
    printf 'remove anyway? [y/N] '
    read -r ans
    [[ "$ans" == [yY] ]] || { echo "aborted."; return 0; }
  fi

  local panes
  panes=$(rex_panes)

  jj --ignore-working-copy -R "$path" workspace forget >/dev/null 2>&1 \
    || echo "warning: jj workspace forget failed; removing the checkout anyway" >&2
  rm -rf "$path" || die_pause "could not delete $path"
  echo "removed ${path/#$HOME/~}"
  close_panes_at "$path" "$panes"
}

# Close every pane at a path, from a rex_panes listing. A session with nothing
# else in it is killed; a session that also holds other work (a --tab agent)
# loses only those panes. This script's own pane goes last, because closing it
# ends the script.
close_panes_at() {
  local path="$1" panes="$2" sid bid
  awk -F'\t' -v p="$path" '
    { all[$1]++; if ($7 == p) { here[$1]++; blocks[$1] = blocks[$1] " " $5 } }
    END { for (s in here) print s "\t" (here[s] == all[s] ? "kill" : blocks[s]) }' <<<"$panes" |
  sort -t$'\t' -k1,1 | awk -F'\t' -v me="${REX_SESSION:-}" '$1 == me { last = $0; next } { print } END { if (last) print last }' |
  while IFS=$'\t' read -r sid what; do
    if [[ "$what" == kill ]]; then
      rex kill "$sid" >/dev/null 2>&1
      continue
    fi
    for bid in $what; do
      [[ "$bid" == "${REX_BLOCK:-}" ]] && continue
      rex block close -s "$sid" "$bid" >/dev/null 2>&1
    done
    [[ " $what " == *" ${REX_BLOCK:-none} "* ]] && rex block close -s "$sid" "$REX_BLOCK" >/dev/null 2>&1
  done
  return 0
}

# Sweep the debris parallel agents leave behind. Pure jj bookkeeping.
cmd_tidy() {
  need jj jq
  local repo="${1:-$(pwd)}"
  jj -R "$repo" root >/dev/null 2>&1 || die "not a jj repo: $repo"
  repo=$(main_root "$(jj -R "$repo" workspace root 2>/dev/null || echo "$repo")")

  local repo_name; repo_name=$(basename "$repo")

  # A workspace jj still tracks whose checkout is gone from disk.
  local dead=()
  while IFS= read -r ws; do
    [[ -z "$ws" || "$ws" == "default" ]] && continue
    [[ -d "$WS_ROOT/$repo_name/$(slug "$ws")" ]] || dead+=("$ws")
  done < <(jjq "$repo" workspace list -T 'self.name() ++ "\n"' 2>/dev/null | sed '/^$/d')

  local divergent
  divergent=$(jjq "$repo" log \
    -r 'divergent() & mutable() & ~remote_bookmarks(remote=origin) & ~working_copies()' \
    --no-graph -T 'change_id.short() ++ " " ++ description.first_line() ++ "\n"' 2>/dev/null | sed '/^$/d')

  local conflicted
  conflicted=$(jjq "$repo" bookmark list --conflicted 2>/dev/null || true)

  local work=0
  if (( ${#dead[@]} )); then
    work=1; echo "workspaces to forget (checkout gone):"
    printf '  %s\n' "${dead[@]}"; echo
  fi
  if [[ -n "$divergent" ]]; then
    work=1; echo "divergent commits to abandon:"; sed 's/^/  /' <<<"$divergent"; echo
  fi
  if [[ -n "$conflicted" ]]; then
    echo "conflicted bookmarks (fix by hand):"; sed 's/^/  /' <<<"$conflicted"
    echo "  jj bookmark delete <name>   OR   jj bookmark track <name>@origin"; echo
  fi
  (( work )) || { echo "nothing to tidy."; return 0; }

  if [[ -t 0 ]]; then
    printf 'proceed? [y/N] '; read -r ans
    [[ "$ans" == [yY] ]] || { echo "aborted."; return 0; }
  fi

  local n=0
  for ws in "${dead[@]}"; do
    jjq "$repo" workspace forget "$ws" >/dev/null 2>&1 && ((n++)) || true
  done
  [[ -n "$divergent" ]] && jjq "$repo" abandon \
    'divergent() & mutable() & ~remote_bookmarks(remote=origin) & ~working_copies()' >/dev/null 2>&1
  echo "forgot $n workspace(s); abandoned divergent commits."
}
# --- agent overview ---------------------------------------------------------

# "12s", "4m", "2h", "3d" since a unix time.
age() {
  local d=$(( $(date +%s) - $1 ))
  if   (( d < 60 ));    then printf '%ds' "$d"
  elif (( d < 3600 ));  then printf '%dm' "$(( d / 60 ))"
  elif (( d < 86400 )); then printf '%dh' "$(( d / 3600 ))"
  else                       printf '%dd' "$(( d / 86400 ))"
  fi
}

# One fzf row per agent pane, and per pane that reports a status, such as a
# deploy script: "<session>\t<block>\t<cwd>\t<display>". Rows that need you sort
# first, like herdr's attention queue, and the longest-waiting first within a
# state.
agent_rows() {
  local sid slabel wid wlabel bid prog cwd state app msg since title
  local rank icon name where
  rex_panes | awk -F'\t' -v re="$AGENT_PROGRAMS" '$6 ~ re || $8 != "-"' |
  while IFS=$'\t' read -r sid slabel wid wlabel bid prog cwd state app msg since title; do
    case "$state" in
      blocked) rank=0 icon=$'\e[31m◆ blocked' ;;
      error)   rank=1 icon=$'\e[31m✗ error  ' ;;
      done)    rank=2 icon=$'\e[32m✓ done   ' ;;
      working) rank=3 icon=$'\e[33m● working' ;;
      idle)    rank=4 icon=$'\e[2m○ idle   ' ;;
      *)       rank=5 icon=$'\e[2m· ?      ' ;;
    esac
    [[ "$since" == - ]] && since="" || icon+=" $(printf '%3s' "$(age "$since")")"
    [[ "$since" ]] || icon+="    "
    icon+=$'\e[0m'
    # The agent's name: its title, else its program. A title that is only a
    # path is a shell prompt, not a name.
    name="$title"
    [[ "$name" == - || "$name" == "~"* || "$name" == /* ]] && name="${app/#-/$prog}"
    [[ "$app" != - && "$app" != claude-code && "$name" != "$app" ]] && name="$name ($app)"
    where="$slabel"
    [[ "$wlabel" != - && "$wlabel" != "Window "* ]] && where+=" › $wlabel"   # skip Rex's default tab name
    [[ "$msg" == - ]] && msg=""
    printf '%s\t%s\t%s\t%s\t%s\t%s  %-36.36s  \e[36m%-30.30s\e[0m  %s\n' \
      "$rank" "${since:-9999999999}" "$sid" "$bid" "$cwd" "$icon" "$name" "$where" "$msg"
  done | sort -t$'\t' -k1,1n -k2,2n | cut -f3-
}

# The list refreshes itself. A background loop scans the panes into a file
# every second and tells fzf to reload from it, so fzf's own reload takes
# milliseconds; a reload that runs the scan blocks keys until it ends. fzf
# takes a socket path only if it ends in .sock. --track with --id-nth keeps the
# cursor on the same pane.
cmd_agents() {
  need rex jq fzf curl
  local self picked
  self=$(command -v "$0" || printf '%s' "$0")
  AGENTS_DIR=$(mktemp -d "${TMPDIR:-/tmp}/rex-agents.XXXXXX") || die_pause "mktemp failed"
  (
    while kill -0 $$ 2>/dev/null; do
      "$self" _agent-rows >"$AGENTS_DIR/rows.new" && mv "$AGENTS_DIR/rows.new" "$AGENTS_DIR/rows"
      curl -s --unix-socket "$AGENTS_DIR/fzf.sock" http://fzf \
        -d "reload-sync(cat '$AGENTS_DIR/rows')" >/dev/null 2>&1
      sleep 1
    done
  ) &
  AGENTS_LOOP=$!
  trap 'kill "$AGENTS_LOOP" 2>/dev/null; rm -rf "$AGENTS_DIR"' EXIT
  picked=$(fzf --ansi --reverse --no-sort --prompt='agent> ' --info=hidden \
      --delimiter='\t' --with-nth=4.. --id-nth=2 --track \
      --listen="$AGENTS_DIR/fzf.sock" \
      --header='↵ jump · esc close' \
      --preview 'printf "\e[2m%s\e[0m\n" {3}; rex capture -s {1} -b {2} --trim | tail -n "$((FZF_PREVIEW_LINES - 1))"' \
      --preview-window=down,60% < <(agent_rows)) || return 0
  local sid bid
  IFS=$'\t' read -r sid bid _ <<<"$picked"
  show "$sid" "$bid"
}

case "${1:-}" in
  new)            shift; cmd_new "$@" ;;
  agents)         shift; cmd_agents "$@" ;;
  ask)            shift; cmd_ask "$@" ;;
  reply)          shift; cmd_reply "$@" ;;
  _agent-rows)    agent_rows ;;
  rm|remove|kill) shift; cmd_rm "$@" ;;
  tidy)           shift; cmd_tidy "$@" ;;
  -h|--help|help|"")
    cat <<'EOF'
rex-jj — jj-workspace-backed agent sessions for Rex

  rex-jj new                pick a repo, then pick or name the work, then
                            pick a model tier
  rex-jj new --repo R --name N [--prompt P] [--tab] [--background] \
            [--model opus|sonnet|flash] [--agent CMD]
                            prints the workspace name on stdout
  rex-jj agents             every agent in Rex with its state; Enter jumps to it
  rex-jj ask W MESSAGE [--timeout S]
                            type MESSAGE into workspace W's agent, wait, print
                            its reply. Exit 2: blocked (reason printed);
                            exit 3: still working at the timeout
  rex-jj reply W [--timeout S]
                            wait for W's agent to stop working, print its reply
  rex-jj rm [path]          in an agent workspace: forget + delete + kill it;
                            anywhere else: just kill the Rex session
  rex-jj tidy [repo]        sweep dead workspaces / divergent commits

The picker is one ranked list — running agents first, then idle workspaces, then
your local bookmarks by recency, then remote ones. Selecting a workspace attaches
to it (continuing its session); selecting a bookmark branches a new workspace off
it; typing a name that matches nothing starts fresh work.

--model picks opus or sonnet (Claude Code), or flash (Gemini Flash via agy).
--agent gives an explicit full launch command and overrides it.
--tab opens the agent as a tab in the current Rex session, not a new session.
--background leaves the app where it is.
W is a workspace name, or a path when the name exists in several repos.

Checkouts live in ~/.herdr/workspaces/<repo>/<name>  ($REX_JJ_ROOT to override).
Agent command: $REX_JJ_AGENT (default: claude --dangerously-skip-permissions).

Keys (config/rex/init.lua):
  prefix+shift+a  new / attach agent     prefix+s        agent overview
  prefix+shift+d  remove this workspace  prefix+shift+y  tidy
EOF
    ;;
  *) die "unknown command: $1 (try --help)" ;;
esac
