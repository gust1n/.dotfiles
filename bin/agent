#!/usr/bin/env bash
# Unified tmux session manager for Claude Code agents in jj workspaces.
# Each agent runs in its own tmux session with its own jj workspace.
# Status icons appear in the session bar via Claude Code hooks + agent-status.

set -uo pipefail

AGENT_PREFIX="ag_"
CODE_DIR="$HOME/Code"

# --- Helpers ---

_fzf_pick() {
  local prompt="$1"
  fzf --prompt="$prompt> " --height=40% --reverse --bind='j:down,k:up'
}

_fzf_pick_full() {
  local prompt="$1"
  fzf --prompt="$prompt> " --height=100% --reverse
}

_fzf_pick_or_create() {
  local prompt="$1"
  local output
  output=$(fzf --prompt="$prompt> " --height=100% --reverse \
    --print-query 2>/dev/null) || true
  local query match
  query=$(echo "$output" | sed -n '1p')
  match=$(echo "$output" | sed -n '2p')
  if [[ -n "$match" ]]; then
    printf '%s\n' "$match"
  elif [[ -n "$query" ]]; then
    printf '%s\n' "$query"
  else
    return 1
  fi
}

_sanitize_name() {
  echo "${1//\//-}"
}

_discover_repos() {
  if command -v fd >/dev/null; then
    fd --no-ignore --hidden --follow --type d '.git' "$CODE_DIR" \
      --exclude '.jj-workspaces' --max-depth 5 2>/dev/null \
      | grep -E '/\.git/?$' \
      | while IFS= read -r git_path; do
          git_path="${git_path%/}"
          local repo_dir="${git_path%/.git}"
          local rel="${repo_dir#$CODE_DIR/}"
          printf '%s\n' "$rel"
        done | sort -u
  else
    find "$CODE_DIR" -maxdepth 4 -name .git -type d \
      -not -path '*/.jj-workspaces/*' 2>/dev/null \
      | while IFS= read -r git_path; do
          local repo_dir="${git_path%/.git}"
          local rel="${repo_dir#$CODE_DIR/}"
          printf '%s\n' "$rel"
        done | sort -u
  fi
}

_ensure_jj_ready() {
  local repo_path="$1"
  if [[ ! -d "$repo_path/.jj" ]]; then
    jj git init --colocate "$repo_path" >/dev/null 2>&1 || true
  fi
  jj --ignore-working-copy -R "$repo_path" git import >/dev/null 2>&1 || true
}

_pick_agent() {
  local agent
  agent=$(printf '%s\n' claude codex gemini | _fzf_pick "Agent") || return 1
  [[ -z "$agent" ]] && return 1
  if ! command -v "$agent" >/dev/null; then
    echo "Command not found: $agent" >&2
    return 1
  fi
  if [[ "$agent" == "claude" ]]; then
    printf '%s\n' "claude --dangerously-skip-permissions"
  else
    printf '%s\n' "$agent"
  fi
}

_agent_sessions() {
  tmux list-sessions -F '#{session_name}' 2>/dev/null | grep "^${AGENT_PREFIX}" || true
}

_session_exists() {
  tmux has-session -t "=${1}" 2>/dev/null
}

_create_workspace() {
  local repo_path="$1"
  local fs_name="$2"
  local workspace_path="${repo_path}/.jj-workspaces/${fs_name}"

  if [[ -d "$workspace_path" ]]; then
    printf '%s\n' "$workspace_path"
    return
  fi

  mkdir -p "$(dirname "$workspace_path")"

  local base_rev=""
  if jj --ignore-working-copy -R "$repo_path" log -r "${fs_name}@origin" --no-graph --limit 1 >/dev/null 2>&1; then
    base_rev="${fs_name}@origin"
  elif jj --ignore-working-copy -R "$repo_path" log -r "$fs_name" --no-graph --limit 1 >/dev/null 2>&1; then
    base_rev="$fs_name"
  elif jj --ignore-working-copy -R "$repo_path" log -r 'main@origin' --no-graph --limit 1 >/dev/null 2>&1; then
    base_rev="main@origin"
  elif jj --ignore-working-copy -R "$repo_path" log -r 'trunk()' --no-graph --limit 1 >/dev/null 2>&1; then
    base_rev="trunk()"
  else
    base_rev="@"
  fi

  jj --ignore-working-copy -R "$repo_path" workspace forget "$fs_name" >/dev/null 2>&1 || true
  jj -R "$repo_path" workspace update-stale >/dev/null 2>&1 || true

  jj -R "$repo_path" workspace add --name "$fs_name" -r "$base_rev" "$workspace_path" >/dev/null 2>&1 \
    || { echo "Failed to create workspace" >&2; return 1; }

  printf '%s\n' "$workspace_path"
}

_cleanup_workspace() {
  local workspace_path="$1"
  local fs_name="$2"

  if [[ -d "$workspace_path" && "$workspace_path" == */.jj-workspaces/* ]]; then
    local repo_path="${workspace_path%%/.jj-workspaces/*}"
    jj --ignore-working-copy -R "$repo_path" workspace forget "$fs_name" 2>/dev/null || true
    rm -rf "$workspace_path"
  fi
}

# --- Commands ---

cmd_new() {
  local repo="" name="" agent_cmd="" prompt_text=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)   repo="$2"; shift 2 ;;
      --name)   name="$2"; shift 2 ;;
      --agent)  agent_cmd="$2"; shift 2 ;;
      --prompt) prompt_text="$2"; shift 2 ;;
      *)        shift ;;
    esac
  done

  # Non-interactive mode
  if [[ -n "$repo" && -n "$name" ]]; then
    agent_cmd="${agent_cmd:-claude --dangerously-skip-permissions}"
    local fs_name
    fs_name=$(_sanitize_name "$name")
    local session_name="${AGENT_PREFIX}${fs_name}"

    if _session_exists "$session_name"; then
      tmux switch-client -t "=$session_name"
      return
    fi

    _ensure_jj_ready "$repo"
    local workspace_path
    workspace_path=$(_create_workspace "$repo" "$fs_name") || return 1

    if [[ -n "$prompt_text" ]]; then
      tmux new-session -d -s "$session_name" -c "$workspace_path" "$agent_cmd --print \"$prompt_text\""
    else
      tmux new-session -d -s "$session_name" -c "$workspace_path" "$agent_cmd"
    fi
    tmux switch-client -t "=$session_name"
    return
  fi

  # Interactive mode
  local repo_rel
  repo_rel=$(_discover_repos | _fzf_pick_full "Repository") || return
  [[ -z "$repo_rel" ]] && return

  repo="$CODE_DIR/$repo_rel"
  _ensure_jj_ready "$repo"

  local bookmarks
  bookmarks=$(jj --ignore-working-copy -R "$repo" bookmark list -T 'self.name() ++ "\n"' 2>/dev/null | sed '/^$/d' | sort -u)

  local remote_bookmarks
  remote_bookmarks=$(jj --ignore-working-copy -R "$repo" bookmark list --all-remotes \
    -T 'if(self.remote(), self.name() ++ "@" ++ self.remote(), "") ++ "\n"' 2>/dev/null \
    | sed '/^$/d' | sort -u)

  local all_bookmarks
  all_bookmarks=$(printf '%s\n%s\n' "$bookmarks" "$remote_bookmarks" | sed '/^$/d' | sort -u)

  local chosen
  chosen=$(printf '%s\n' "$all_bookmarks" | _fzf_pick_or_create "Task name (or pick bookmark)")
  [[ -z "$chosen" ]] && return

  local workspace_name="${chosen%%@origin}"
  local fs_name
  fs_name=$(_sanitize_name "$workspace_name")
  local session_name="${AGENT_PREFIX}${fs_name}"

  if _session_exists "$session_name"; then
    tmux switch-client -t "=$session_name"
    return
  fi

  agent_cmd=$(_pick_agent) || return

  local workspace_path
  workspace_path=$(_create_workspace "$repo" "$fs_name") || return 1

  tmux new-session -d -s "$session_name" -c "$workspace_path" "$agent_cmd"
  tmux switch-client -t "=$session_name"
}

cmd_ls() {
  local sessions
  sessions=$(_agent_sessions)
  if [[ -z "$sessions" ]]; then
    echo "No agent sessions."
    return
  fi
  printf "%-4s %-30s %s\n" "#" "NAME" "STATUS"
  local idx=0
  while IFS= read -r name; do
    idx=$((idx + 1))
    local display="${name#$AGENT_PREFIX}"
    local status
    status=$(tmux show-options -t "$name" -v @agent_status 2>/dev/null || true)
    printf "%-4s %-30s %s\n" "$idx" "$display" "${status:--}"
  done <<< "$sessions"
}

cmd_switch() {
  local name="${1:-}"
  if [[ -n "$name" ]]; then
    local session_name="${AGENT_PREFIX}${name}"
    if _session_exists "$session_name"; then
      tmux switch-client -t "=$session_name"
    else
      echo "Agent session not found: $name" >&2
      return 1
    fi
    return
  fi

  local sessions
  sessions=$(_agent_sessions)
  if [[ -z "$sessions" ]]; then
    echo "No agent sessions." >&2
    return 1
  fi
  local picked
  picked=$(echo "$sessions" | while IFS= read -r name; do
    local status
    status=$(tmux show-options -t "$name" -v @agent_status 2>/dev/null || true)
    printf '%s %s\n' "${name#$AGENT_PREFIX}" "${status:--}"
  done | _fzf_pick "Switch to agent") || return
  picked="${picked%% *}"
  [[ -n "$picked" ]] && cmd_switch "$picked"
}

cmd_kill() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    local sessions
    sessions=$(_agent_sessions)
    if [[ -z "$sessions" ]]; then
      echo "No agent sessions." >&2
      return 1
    fi
    name=$(echo "$sessions" | while IFS= read -r sname; do
      local status
      status=$(tmux show-options -t "$sname" -v @agent_status 2>/dev/null || true)
      printf '%s %s\n' "${sname#$AGENT_PREFIX}" "${status:--}"
    done | _fzf_pick "Kill agent") || return
    name="${name%% *}"
    [[ -z "$name" ]] && return
  fi

  local session_name="${AGENT_PREFIX}${name}"
  if ! _session_exists "$session_name"; then
    echo "Agent session not found: $name" >&2
    return 1
  fi

  # Get workspace path before killing
  local pane_path
  pane_path=$(tmux display-message -t "=$session_name" -p '#{pane_current_path}' 2>/dev/null || true)

  # Switch away if we're in the session being killed
  local current_session
  current_session=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
  if [[ "$current_session" == "$session_name" ]]; then
    tmux switch-client -l 2>/dev/null || tmux switch-client -n 2>/dev/null || true
  fi

  tmux kill-session -t "=$session_name"

  if [[ -n "$pane_path" && "$pane_path" == */.jj-workspaces/* ]]; then
    _cleanup_workspace "$pane_path" "$name"
    echo "Killed agent '$name' and cleaned up workspace."
  else
    echo "Killed agent '$name'."
  fi
}

cmd_send() {
  local name="${1:?Usage: agent send <name> <message>}"
  shift
  local msg="$*"
  local session_name="${AGENT_PREFIX}${name}"
  if ! _session_exists "$session_name"; then
    echo "Agent session not found: $name" >&2
    return 1
  fi
  tmux send-keys -t "=$session_name" "$msg" Enter
}

cmd_capture() {
  local name="${1:?Usage: agent capture <name>}"
  local lines="${2:-200}"
  local session_name="${AGENT_PREFIX}${name}"
  if ! _session_exists "$session_name"; then
    echo "Agent session not found: $name" >&2
    return 1
  fi
  tmux capture-pane -t "=$session_name" -p -S "-$lines"
}

cmd_tidy() {
  local repo="${1:-$(pwd)}"

  if ! jj -R "$repo" root >/dev/null 2>&1; then
    echo "Not a jj repo: $repo" >&2
    return 1
  fi
  repo=$(jj -R "$repo" root 2>/dev/null)

  # Get list of live agent session names
  local live_workspaces=""
  while IFS= read -r sname; do
    [[ -z "$sname" ]] && continue
    live_workspaces+="${sname#$AGENT_PREFIX}"$'\n'
  done <<< "$(_agent_sessions)"

  # Find dead workspaces (no corresponding tmux session)
  local dead_workspaces=()
  while IFS= read -r ws; do
    [[ -z "$ws" || "$ws" == "default" ]] && continue
    if ! echo "$live_workspaces" | grep -qxF "$ws"; then
      dead_workspaces+=("$ws")
    fi
  done < <(jj --ignore-working-copy -R "$repo" workspace list \
    -T 'self.name() ++ "\n"' 2>/dev/null | sed '/^$/d')

  # Find divergent commits to abandon
  local divergent
  divergent=$(jj --ignore-working-copy -R "$repo" log \
    -r 'divergent() & mutable() & ~remote_bookmarks(remote=origin) & ~working_copies()' \
    --no-graph -T 'change_id.short() ++ " " ++ description.first_line() ++ "\n"' 2>/dev/null | sed '/^$/d')

  # Find conflicted bookmarks
  local conflicted
  conflicted=$(jj --ignore-working-copy -R "$repo" bookmark list --conflicted 2>/dev/null || true)

  local has_work=false
  if [[ ${#dead_workspaces[@]} -gt 0 ]]; then
    has_work=true
    echo "Dead workspaces to forget:"
    for ws in "${dead_workspaces[@]}"; do
      echo "  $ws"
    done
    echo ""
  fi

  if [[ -n "$divergent" ]]; then
    has_work=true
    echo "Divergent commits to abandon:"
    while IFS= read -r line; do
      echo "  $line"
    done <<< "$divergent"
    echo ""
  fi

  if [[ -n "$conflicted" ]]; then
    echo "Conflicted bookmarks (manual fix needed):"
    echo "$conflicted"
    echo "  Fix with: jj bookmark delete <name>  OR  jj bookmark track <name>@origin"
    echo ""
  fi

  if [[ "$has_work" != true ]]; then
    echo "Nothing to tidy."
    return 0
  fi

  printf "Proceed? [y/N] "
  read -r answer
  if [[ "$answer" != [yY] ]]; then
    echo "Aborted."
    return 0
  fi

  local dead_count=0
  for ws in "${dead_workspaces[@]}"; do
    jj --ignore-working-copy -R "$repo" workspace forget "$ws" 2>/dev/null || true
    local ws_dir="$repo/.jj-workspaces/$ws"
    [[ -d "$ws_dir" ]] && rm -rf "$ws_dir"
    ((dead_count++)) || true
  done

  local divergent_count=0
  if [[ -n "$divergent" ]]; then
    divergent_count=$(echo "$divergent" | wc -l | tr -d ' ')
    jj --ignore-working-copy -R "$repo" abandon \
      'divergent() & mutable() & ~remote_bookmarks(remote=origin) & ~working_copies()' \
      2>/dev/null || true
  fi

  local orphaned
  orphaned=$(jj --ignore-working-copy -R "$repo" log \
    -r 'conflict() & mutable() & ~bookmarks() & ~working_copies() & ~descendants(working_copies())' \
    --no-graph -T 'change_id.short() ++ "\n"' 2>/dev/null | sed '/^$/d')
  if [[ -n "$orphaned" ]]; then
    jj --ignore-working-copy -R "$repo" abandon \
      'conflict() & mutable() & ~bookmarks() & ~working_copies() & ~descendants(working_copies())' \
      2>/dev/null || true
    local orphan_count
    orphan_count=$(echo "$orphaned" | wc -l | tr -d ' ')
    divergent_count=$((divergent_count + orphan_count))
  fi

  echo "Done: forgot ${dead_count} workspaces, abandoned ${divergent_count} divergent commits."
}

cmd_jump_next() {
  local done_icon waiting_icon stale_icon
  done_icon=$(printf '\xef\x80\x8c')
  waiting_icon=$(printf '\xef\x83\xa5')
  stale_icon=$(printf '\xef\x81\xb1')

  local target=""
  while IFS= read -r name; do
    local status
    status=$(tmux show-options -t "$name" -v @agent_status 2>/dev/null || true)
    if [[ "$status" == "$done_icon" || "$status" == "$waiting_icon" || "$status" == "$stale_icon" ]]; then
      target="$name"
      break
    fi
  done <<< "$(_agent_sessions)"

  if [[ -n "$target" ]]; then
    tmux switch-client -t "=$target"
  else
    tmux display-message "No agents waiting or done."
  fi
}

cmd_code() {
  local repo_rel
  repo_rel=$(_discover_repos | _fzf_pick_full "Repository") || return
  [[ -z "$repo_rel" ]] && return

  local repo="$CODE_DIR/$repo_rel"
  local session_name="${repo_rel//\//-}"

  if _session_exists "$session_name"; then
    tmux switch-client -t "=$session_name"
    return
  fi

  tmux new-session -d -s "$session_name" -c "$repo"
  tmux switch-client -t "=$session_name"
}

cmd_menu() {
  local current_session
  current_session=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)

  local options
  options=$(printf '%s\n%s\n' "+ New agent" "+ Code session")
  local entries=""

  # List all sessions
  while IFS= read -r name; do
    [[ "$name" == "$current_session" ]] && continue
    if [[ "$name" == ${AGENT_PREFIX}* ]]; then
      local display="${name#$AGENT_PREFIX}"
      local status
      status=$(tmux show-options -t "$name" -v @agent_status 2>/dev/null || true)
      entries+="$(printf '%s %s\n' "$display" "${status:-}")"$'\n'
    else
      entries+="$name"$'\n'
    fi
  done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)

  local all_options
  all_options=$(printf '%s\n%s' "$options" "$entries" | sed '/^$/d')

  if _agent_sessions | grep -q .; then
    all_options=$(printf '%s\n%s' "$all_options" "× Kill agent")
  fi

  local choice
  choice=$(printf '%s\n' "$all_options" | _fzf_pick "Session") || return
  [[ -z "$choice" ]] && return

  case "$choice" in
    "+ New agent")
      cmd_new
      ;;
    "+ Code session")
      cmd_code
      ;;
    "× Kill agent"*)
      cmd_kill
      ;;
    *)
      local clean="${choice%% *}"
      local session_name="${AGENT_PREFIX}${clean}"
      if _session_exists "$session_name"; then
        tmux switch-client -t "=$session_name"
      elif _session_exists "$clean"; then
        tmux switch-client -t "=$clean"
      fi
      ;;
  esac
}

# --- Dispatch ---

case "${1:-}" in
  new)       shift; cmd_new "$@" ;;
  ls|list)   cmd_ls ;;
  switch|sw) shift; cmd_switch "$@" ;;
  kill)      shift; cmd_kill "$@" ;;
  send)      shift; cmd_send "$@" ;;
  capture)   shift; cmd_capture "$@" ;;
  tidy)      shift; cmd_tidy "$@" ;;
  jump-next) cmd_jump_next ;;
  -h|--help|help)
    cat <<EOF
Usage: agent [command] [args...]

Commands:
  (none)                    Interactive fzf menu (all sessions + new/kill)
  new [--repo R --name N]   Create new agent session (interactive or scripted)
  ls                        List agent sessions with status
  switch [name]             Switch to agent session
  kill [name]               Kill agent and clean up workspace
  send <name> <msg>         Send input to an agent
  capture <name> [lines]    Capture agent pane output
  tidy [repo]               Clean up dead workspaces & divergent commits
  jump-next                 Jump to first done/waiting agent

Tmux bindings:
  C-a A     Open this menu as a popup
  C-a l     Jump to next done/waiting agent
  M-1..9    Switch to Nth session

Status icons (set via Claude Code hooks):
  working   waiting for input   done
EOF
    ;;
  *)
    cmd_menu
    ;;
esac
